---
import "@fontsource/permanent-marker";
import "@fontsource-variable/inter/wght.css";
import "@fontsource/poppins";
import "@/styles/global.css";
import ButtonFinal from "@/components/global/ButtonFinal.astro";
import { SITE_CONFIG } from "@/components/constants/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
}

const { title, description, image, canonicalUrl } = Astro.props;

const siteUrl = "https://gymtabaku.com";
const pageTitle = title
  ? `${title} | Gym Tabaku`
  : "Gym Tabaku | Gimnasio en Bogotá Kennedy";
const pageDescription =
  description ||
  "Gym Tabaku: El mejor gimnasio en Bogotá, sector Kennedy. Entrenamientos personalizados, clases grupales, pesas, cardio y la mejor comunidad fitness.";
const canonical =
  canonicalUrl ||
  (Astro.site
    ? new URL(Astro.url.pathname, Astro.site).href
    : new URL(Astro.url.pathname, siteUrl).href);
const ogImage = image
  ? image.startsWith("http")
    ? image
    : new URL(image, siteUrl).href
  : `${siteUrl}/img/bg/heeder.webp`;

const isHomePage =
  Astro.url.pathname === "/" || Astro.url.pathname === "";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ExerciseGym",
  name: SITE_CONFIG.name,
  description: SITE_CONFIG.description,
  url: siteUrl,
  logo: `${siteUrl}/img/logo.webp`,
  image: `${siteUrl}/img/bg/heeder.webp`,
  telephone: `+57${SITE_CONFIG.contact.phone}`,
  priceRange: "$$",
  address: {
    "@type": "PostalAddress",
    streetAddress: SITE_CONFIG.contact.address,
    addressLocality: "Bogotá",
    addressRegion: "Cundinamarca",
    addressCountry: "CO",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 4.6386711,
    longitude: -74.1546467,
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "05:00",
      closes: "22:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: "Saturday",
      opens: "06:00",
      closes: "18:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Sunday", "PublicHolidays"],
      opens: "07:00",
      closes: "14:00",
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/img/logo.webp" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Primario -->
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Gym Tabaku" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_CO" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    {/* Preload Hero LCP Image on Homepage */}
    {
      isHomePage && (
        <link
          rel="preload"
          as="image"
          href="/img/bg/heeder.webp"
          fetchpriority="high"
        />
      )
    }

    <!-- Schema.org JSON-LD -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
  </head>
  <body class="relative">
    <slot />
    <ButtonFinal />
    <script src="@/utils/scrollReveal.ts"></script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>
