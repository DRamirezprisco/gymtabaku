---
import Menu from "@/components/Menu.astro";
import Button from "@/components/global/Button.astro";
---

<section class="relative bg-black bg-cover w-full overflow-hidden min-h-screen">
    <img
        src="/img/bg/intento9.webp"
        alt="fondo de pagina"
        class="absolute w-full top-0 object-cover mix-blend-screen opacity-80 h-full"
    />

    <div class="relative z-10">
        <Menu />

        <main
            class="max-w-sm sm:max-w-lg md:max-w-2xl lg:max-w-4xl xl:max-w-5xl 2xl:max-w-7xl mx-auto w-full px-4 py-12"
        >
            <header
                class="max-w-md sm:max-w-lg md:max-w-4xl lg:max-w-6xl xl:max-w-7xl mx-auto text-center mb-12 sm:mb-16"
            >
                <h2
                    class="mt-50 mb-10 sm:text-3xl md:text-2xl xl:text-xl text-primary-500 font-black tracking-tight uppercase"
                >
                    cuerpo · mente · comunidad
                </h2>
                <h1
                    class={`font-serif sm:text-4xl lg:text-5xl xl:text-6xl text-gym-dark-text-primary  font-bold uppercase`}
                >
                    No somos solo un <span
                        class="md:block sm:text-4xl lg:text-5xl xl:text-6xl text-primary-500 mt-3"
                        >gimnasio</span
                    >
                </h1>
                <h3
                    class={`text-base md:text-lg lg:text-2xl text-gym-dark-text-primary my-12`}
                >
                    Somos una comunidad de bienestar, movimiento y crecimiento
                    personal
                </h3>

                <div
                    class="flex flex-col sm:flex-row justify-center items-center gap-10"
                >
                    <Button text="reserva tu clase de cortesia" />
                    <Button text="Contactanos" white />
                </div>
            </header>
        </main>
    </div>
</section>
