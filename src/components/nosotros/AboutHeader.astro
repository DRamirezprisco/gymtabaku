---
import Menu from "@/components/Menu.astro";
import Button from "@/components/global/Button.astro";
import { COURTESY_CLASS_WA_URL } from "@/components/constants/site";
---

<section
    class="relative bg-black bg-cover w-full overflow-hidden min-h-screen pb-12 sm:pb-16"
>
    <img
        src="/img/bg/intento9.webp"
        alt=""
        aria-hidden="true"
        class="absolute w-full top-0 object-cover mix-blend-screen opacity-70 sm:opacity-80 h-full pointer-events-none select-none"
    />

    <div class="relative z-10">
        <Menu />

        <main
            class="max-w-6xl 2xl:max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 sm:py-12 md:py-16"
        >
            <header class="max-w-4xl mx-auto text-center" data-reveal="fade-up">
                <h2
                    class="mt-20 sm:mt-28 md:mt-36 lg:mt-40 mb-4 sm:mb-6 text-xs sm:text-sm md:text-base lg:text-lg text-primary-500 font-bold tracking-widest uppercase"
                >
                    cuerpo · mente · comunidad
                </h2>
                <h1
                    class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl text-gym-dark-text-primary font-black uppercase tracking-tight leading-tight"
                >
                    No somos solo un{" "}
                    <span
                        class="text-primary-500 block sm:inline md:block mt-1 sm:mt-0 md:mt-2"
                    >
                        gimnasio
                    </span>
                </h1>
                <h3
                    class="text-base sm:text-lg md:text-xl lg:text-2xl text-gym-dark-text-primary my-6 sm:my-8 lg:my-10 max-w-2xl mx-auto font-normal leading-relaxed"
                >
                    Somos una comunidad de bienestar, movimiento y crecimiento
                    personal
                </h3>

                <div
                    class="flex flex-col sm:flex-row justify-center items-center gap-4 sm:gap-6 mt-4"
                >
                    <Button
                        text="reserva tu clase de cortesia"
                        url={COURTESY_CLASS_WA_URL}
                    />
                    <Button text="Contactanos" white url="/contactanos" />
                </div>
            </header>
        </main>
    </div>
</section>
