---

<section class="relative bg-black bg-cover w-full overflow-hidden min-h-screen">
    <img
        src="/img/bg/intento4.jpg"
        alt="fondo de pagina"
        class="absolute -left-35 rotate-180 top-0 w-auto object-cover opacity-80 mix-blend-screen h-full"
    />

    <div class="relative z-10">
        <Menu />

        <main
            class="max-w-sm sm:max-w-lg md:max-w-2xl lg:max-w-4xl xl:max-w-5xl 2xl:max-w-7xl mx-auto w-full px-4 py-12"
        >
            <header
                class="max-w-md sm:max-w-lg md:max-w-4xl lg:max-w-6xl xl:max-w-7xl mx-auto text-center mb-12 sm:mb-16"
            >
                <h3
                    class={`font-serif text-base sm:text-lg md:text-xl lg:text-3xl text-gym-dark-text-primary`}
                >
                    Entrena, crece y pertenece!
                </h3>
                <h1
                    class="mt-4 sm:text-4xl md:text-3xl xl:text-2xl text-secondary-400 font-black tracking-tight"
                >
                    Un espacio para entrenar, crecer y sentirte como en casa
                </h1>
            </header>

            <div
                class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start"
            >
                <nav
                    class="lg:col-span-4 p-6 pt-12 rounded-2xl bg-gym-bg-card/30 backdrop-blur-md shadow-xl"
                >
                    <ul class="flex flex-col gap-4" id="service-menu">
                        {
                            items.map((item, index) => (
                                <li>
                                    <Button2
                                        text={item.title}
                                        isActive={index === 0}
                                    />
                                </li>
                            ))
                        }
                    </ul>
                </nav>

                <div id="servicesItemContainer" class="w-full lg:col-span-8">
                    {
                        items.map((item, index) => (
                            <ServiceItems
                                title={item.title}
                                icon={item.icon}
                                subtitle={item.subtitle}
                                videoUrl={item.videoUrl}
                                description={item.description}
                                serviceItemId={item.serviceItemId}
                                isActive={index === 0}
                            />
                        ))
                    }
                </div>
            </div>
        </main>
    </div>
</section>

<section
    class="relative bg-gym-bg bg-[url('/img/bg/bgclaro1.webp')] bg-cover w-full overflow-hidden min-h-screen p-10"
>
    <img
        src="/img/bg/bgyellow.webp"
        alt=""
        class="absolute -right-10 -top-10 size-48 md:size-52 lg:size-48 xl:size-52 2xl:size-90"
    />
    <img
        src="/img/bg/bgclarotexture.webp"
        alt=""
        class="absolute -right-10 -top-10 size-48 md:size-52 lg:size-48 xl:size-49 2xl:size-86"
    />
    <div id="galleryContainer" class="max-w-7xl mx-auto px-4">
        {
            items.map((item, index) => (
                <Gallery
                    images={item.images}
                    title={item.title}
                    isActive={index === 0}
                />
            ))
        }
    </div>
</section>

<script>
    // Interacción en el cliente para alternar la clase 'is-active'
    const menu = document.getElementById("service-menu");
    const buttons = menu?.querySelectorAll("button");
    const container = document.getElementById("servicesItemContainer");
    const serviceItems = container?.querySelectorAll("article");
    const galleryContainer = document.getElementById("galleryContainer");
    const galleriesTitles = galleryContainer?.querySelectorAll("h2");
    const galleries = galleryContainer?.querySelectorAll("div");

    buttons?.forEach((button, index) => {
        button.addEventListener("click", () => {
            // Quitar la clase a todos los botones
            buttons.forEach((btn) => btn.classList.remove("is-active"));

            // Quitar la clase a todos los serviceItems
            serviceItems?.forEach((item) => item.classList.remove("is-active"));

            galleriesTitles?.forEach((item) =>
                item.classList.remove("is-active"),
            );

            galleries?.forEach((item) => item.classList.remove("is-active"));

            // Agregar la clase al botón seleccionado
            button.classList.add("is-active");

            // Agregar la clase al serviceItems seleccionado
            serviceItems?.[index].classList.add("is-active");

            galleriesTitles?.[index].classList.add("is-active");

            galleries?.[index].classList.add("is-active");
        });
    });
</script>
