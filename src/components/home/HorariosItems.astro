---
// HorariosItems.astro
import BadgeHorarios from "./horarios/BadgeHorarios.astro";
import CardLunesViernes from "./horarios/CardLunesViernes.astro";
import CardClasesGrupales from "./horarios/CardClasesGrupales.astro";
import CardSabados from "./horarios/CardSabados.astro";
import CardDomingo from "./horarios/CardDomingo.astro";
import CardFestivos from "./horarios/CardFestivos.astro";
---

<div class="relative container mx-auto px-3 sm:px-4 py-6 mb-8 sm:mb-12">
  {
    /* Imagen de fondo imghorarios (nítida y visible para lucir la foto del gimnasio) */
  }
  <div
    class="absolute inset-0 bg-cover bg-center rounded-2xl -z-10 shadow-2xl"
    style="background-image: url('/img/imghorarios.webp');"
  >
  </div>

  {/* Insignia superior con atleta y mensaje */}
  <div
    data-reveal="zoom-in"
    data-reveal-delay="500"
    data-reveal-duration="450ms"
  >
    <BadgeHorarios />
  </div>

  {/* ========================================================= */}
  {/* VERSIÓN MÓVIL Y TABLET (< lg): Slider Infinito con 5 cards */}
  {/* ========================================================= */}
  <div
    class="block lg:hidden mt-24 sm:mt-32 md:mt-40 mb-8"
    data-reveal="fade-up"
    data-reveal-delay="500"
    data-reveal-duration="500ms"
  >
    {/* Carrusel táctil y arrastrable */}
    <div
      id="horariosSlider"
      class="flex gap-4 sm:gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory py-2 px-1 cursor-grab active:cursor-grabbing [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    >
      {/* Set 1 */}
      <div class="w-[82vw] max-w-[320px] sm:max-w-[360px] shrink-0 snap-center">
        <CardLunesViernes />
      </div>
      <div class="w-[82vw] max-w-[320px] sm:max-w-[360px] shrink-0 snap-center">
        <CardClasesGrupales />
      </div>
      <div class="w-[82vw] max-w-[320px] sm:max-w-[360px] shrink-0 snap-center">
        <CardSabados />
      </div>
      <div class="w-[82vw] max-w-[320px] sm:max-w-[360px] shrink-0 snap-center">
        <CardDomingo />
      </div>
      <div class="w-[82vw] max-w-[320px] sm:max-w-[360px] shrink-0 snap-center">
        <CardFestivos />
      </div>

      {/* Set 2 (Centro visible por defecto) */}
      <div class="w-[82vw] max-w-[320px] sm:max-w-[360px] shrink-0 snap-center">
        <CardLunesViernes />
      </div>
      <div class="w-[82vw] max-w-[320px] sm:max-w-[360px] shrink-0 snap-center">
        <CardClasesGrupales />
      </div>
      <div class="w-[82vw] max-w-[320px] sm:max-w-[360px] shrink-0 snap-center">
        <CardSabados />
      </div>
      <div class="w-[82vw] max-w-[320px] sm:max-w-[360px] shrink-0 snap-center">
        <CardDomingo />
      </div>
      <div class="w-[82vw] max-w-[320px] sm:max-w-[360px] shrink-0 snap-center">
        <CardFestivos />
      </div>

      {/* Set 3 */}
      <div class="w-[82vw] max-w-[320px] sm:max-w-[360px] shrink-0 snap-center">
        <CardLunesViernes />
      </div>
      <div class="w-[82vw] max-w-[320px] sm:max-w-[360px] shrink-0 snap-center">
        <CardClasesGrupales />
      </div>
      <div class="w-[82vw] max-w-[320px] sm:max-w-[360px] shrink-0 snap-center">
        <CardSabados />
      </div>
      <div class="w-[82vw] max-w-[320px] sm:max-w-[360px] shrink-0 snap-center">
        <CardDomingo />
      </div>
      <div class="w-[82vw] max-w-[320px] sm:max-w-[360px] shrink-0 snap-center">
        <CardFestivos />
      </div>
    </div>

    {/* Controles y guía de navegación (debajo de las tarjetas) */}
    <div class="flex items-center justify-between px-2 mt-4 sm:mt-5">
      <div
        class="flex items-center gap-1.5 text-xs text-gym-dark-text-secondary"
      >
        <svg
          class="size-3.5 text-gym-yellow animate-pulse"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
        <span class="font-medium">Desliza o arrastra para ver los horarios</span
        >
      </div>

      <div class="flex items-center gap-2">
        <button
          id="horariosPrevBtn"
          type="button"
          aria-label="Ver horario anterior"
          class="size-8 sm:size-9 rounded-full bg-secondary-900/70 hover:bg-secondary-800 text-gym-dark-text-secondary flex items-center justify-center transition-colors cursor-pointer border border-white/20 active:scale-95 shadow-md"
        >
          <svg
            class="size-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M15 19l-7-7 7-7"></path>
          </svg>
        </button>
        <button
          id="horariosNextBtn"
          type="button"
          aria-label="Ver horario siguiente"
          class="size-8 sm:size-9 rounded-full bg-secondary-900/70 hover:bg-secondary-800 text-gym-dark-text-secondary flex items-center justify-center transition-colors cursor-pointer border border-white/20 active:scale-95 shadow-md"
        >
          <svg
            class="size-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  {/* ========================================================= */}
  {/* VERSIÓN DESKTOP (>= lg): Filas con 2 tarjetas y 3 tarjetas */}
  {/* ========================================================= */}
  <div class="hidden lg:block space-y-8 max-w-6xl mx-auto my-8">
    {
      /* Fila 1: Tarjetas a los extremos para dejar ver el centro de la imagen (la cara del atleta) */
    }
    <div class="grid grid-cols-3 gap-6 xl:gap-8">
      <div
        data-reveal="fade-right"
        data-reveal-delay="500"
        data-reveal-duration="500ms"
      >
        <CardLunesViernes />
      </div>
      <div></div>
      <div
        data-reveal="fade-left"
        data-reveal-delay="700"
        data-reveal-duration="500ms"
      >
        <CardClasesGrupales />
      </div>
    </div>

    {/* Fila 2: 3 tarjetas distribuidas abajo */}
    <div class="grid grid-cols-3 gap-6 xl:gap-8">
      <div
        data-reveal="fade-up"
        data-reveal-delay="700"
        data-reveal-duration="500ms"
      >
        <CardSabados />
      </div>
      <div
        data-reveal="fade-up"
        data-reveal-delay="800"
        data-reveal-duration="500ms"
      >
        <CardDomingo />
      </div>
      <div
        data-reveal="fade-up"
        data-reveal-delay="900"
        data-reveal-duration="500ms"
      >
        <CardFestivos />
      </div>
    </div>
  </div>
</div>

<script>
  function initHorariosSlider() {
    const slider = document.getElementById("horariosSlider");
    const prevBtn = document.getElementById("horariosPrevBtn");
    const nextBtn = document.getElementById("horariosNextBtn");

    if (!slider) return;

    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;
    let isResetting = false;

    const getSetWidth = () => {
      const card0 = slider.children[0] as HTMLElement | undefined;
      const card5 = slider.children[5] as HTMLElement | undefined;
      if (!card0 || !card5) return 0;
      return card5.offsetLeft - card0.offsetLeft;
    };

    const setInitialPosition = () => {
      const singleSetWidth = getSetWidth();
      if (singleSetWidth > 0 && slider.scrollLeft === 0) {
        slider.classList.remove("scroll-smooth");
        slider.style.scrollBehavior = "auto";
        slider.scrollLeft = singleSetWidth;
        requestAnimationFrame(() => {
          slider.style.scrollBehavior = "";
          slider.classList.add("scroll-smooth");
        });
      }
    };

    // Teletransporte imperceptible para loop infinito
    const teleport = (offset: number) => {
      isResetting = true;
      const originalSnap = slider.style.scrollSnapType;
      slider.classList.remove("scroll-smooth");
      slider.style.scrollBehavior = "auto";
      slider.style.scrollSnapType = "none";

      slider.scrollLeft += offset;

      requestAnimationFrame(() => {
        slider.style.scrollBehavior = "";
        slider.style.scrollSnapType = originalSnap;
        slider.classList.add("scroll-smooth");
        isResetting = false;
      });
    };

    slider.addEventListener("scroll", () => {
      if (isDown || isResetting) return;

      const singleSetWidth = getSetWidth();
      if (singleSetWidth <= 0) return;

      if (slider.scrollLeft >= singleSetWidth * 1.8) {
        teleport(-singleSetWidth);
      } else if (slider.scrollLeft <= singleSetWidth * 0.2) {
        teleport(singleSetWidth);
      }
    });

    // Desplazamiento con Mouse Drag
    slider.addEventListener("mousedown", (e) => {
      isDown = true;
      slider.classList.add("cursor-grabbing");
      slider.classList.remove("cursor-grab");
      slider.classList.remove("scroll-smooth");
      slider.style.scrollSnapType = "none";
      startX = e.pageX - slider.offsetLeft;
      scrollLeft = slider.scrollLeft;
    });

    const stopDragging = () => {
      if (!isDown) return;
      isDown = false;
      slider.classList.remove("cursor-grabbing");
      slider.classList.add("cursor-grab");
      slider.classList.add("scroll-smooth");
      slider.style.scrollSnapType = "";
    };

    slider.addEventListener("mouseleave", stopDragging);
    slider.addEventListener("mouseup", stopDragging);

    slider.addEventListener("mousemove", (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - slider.offsetLeft;
      const walk = (x - startX) * 1.5;
      slider.scrollLeft = scrollLeft - walk;

      const singleSetWidth = getSetWidth();
      if (singleSetWidth > 0) {
        if (slider.scrollLeft >= singleSetWidth * 1.8) {
          slider.scrollLeft -= singleSetWidth;
          scrollLeft -= singleSetWidth;
        } else if (slider.scrollLeft <= singleSetWidth * 0.2) {
          slider.scrollLeft += singleSetWidth;
          scrollLeft += singleSetWidth;
        }
      }
    });

    // Botones de navegación
    if (prevBtn) {
      prevBtn.addEventListener("click", () => {
        const card0 = slider.children[0] as HTMLElement | undefined;
        const card1 = slider.children[1] as HTMLElement | undefined;
        const step = card0 && card1 ? card1.offsetLeft - card0.offsetLeft : 300;
        slider.scrollBy({ left: -step, behavior: "smooth" });
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener("click", () => {
        const card0 = slider.children[0] as HTMLElement | undefined;
        const card1 = slider.children[1] as HTMLElement | undefined;
        const step = card0 && card1 ? card1.offsetLeft - card0.offsetLeft : 300;
        slider.scrollBy({ left: step, behavior: "smooth" });
      });
    }

    // Inicializar posición
    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            setInitialPosition();
          }
        });
      });
      observer.observe(slider);
    } else {
      setInitialPosition();
    }
  }

  document.addEventListener("DOMContentLoaded", initHorariosSlider);
  document.addEventListener("astro:page-load", initHorariosSlider);
</script>
