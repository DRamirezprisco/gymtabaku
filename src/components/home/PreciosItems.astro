---
interface Props {
  isHalfwidth?: boolean;
}

const { isHalfwidth = false } = Astro.props;

// PreciosItems.astro
const prices = [
  {
    price: "70.000",
    duration: "1 MES",
    isVip: false,
    isActive: false,
  },
  {
    price: "170.000",
    duration: "3 MESES",
    isVip: false,
    isActive: false,
  },
  {
    price: "270.000",
    duration: "5 MESES",
    isVip: false,
    isActive: true,
  },
  {
    price: "400.000",
    duration: "8 MESES",
    isVip: false,
    isActive: false,
  },
  {
    price: "520.000",
    duration: "1 AÑO",
    isVip: true,
    isActive: false,
  },
];
---

<div
  data-prices-container
  class:list={[
    "mx-auto w-full flex flex-col space-y-1",
    isHalfwidth
      ? "max-w-md sm:max-w-lg lg:max-w-xl mt-4 sm:mt-6 px-2 sm:px-4"
      : "max-w-md sm:max-w-lg md:max-w-2xl lg:max-w-3xl mt-8 sm:mt-12 px-4 sm:px-6",
  ]}
>
  {
    prices.map((item) => (
      /* Cada tarjeta tiene su propio skew individual (-skew-x-6 en móvil, -skew-x-12 en sm+).
         Por defecto la tarjeta con isActive: true se muestra más grande (scale) y con color bg-primary-500.
         Al hacer hover sobre otra tarjeta, la anterior se desactiva y la nueva toma el protagonismo.
         Al retirar el cursor, la tarjeta por defecto vuelve a activarse. */
      <div
        data-price-card
        data-default-active={item.isActive ? "true" : undefined}
        data-active={item.isActive ? "true" : "false"}
        class:list={[
          "group relative flex items-stretch rounded-lg sm:rounded-xl overflow-hidden -skew-x-6 sm:-skew-x-12 cursor-pointer select-none transition-all duration-300 ease-out",
          "data-[active=true]:border-gym-yellow data-[active=true]:shadow-[0_0_30px_rgba(255,204,0,0.28)] data-[active=true]:z-20",
          "data-[active=false]:border-transparent data-[active=false]:shadow-md data-[active=false]:scale-100 data-[active=false]:z-10",
          isHalfwidth
            ? "data-[active=true]:scale-[1.03] sm:data-[active=true]:scale-[1.05]"
            : "data-[active=true]:scale-115 sm:data-[active=true]:scale-115",
        ]}
      >
        {/* Lado Izquierdo (Oscuro con textura bgmenu.webp) */}
        <div
          class:list={[
            "flex-1 flex items-center min-w-0 bg-gym-dark-bg bg-[url('/img/bg/bgmenu.webp')] bg-cover bg-center relative",
            isHalfwidth
              ? "gap-2.5 sm:gap-3.5 pl-3.5 sm:pl-5 md:pl-6 py-2.5 sm:py-3"
              : "gap-3 sm:gap-5 pl-4 sm:pl-7 md:pl-8 py-3 sm:py-4 md:py-4.5",
          ]}
        >
          <div class="absolute inset-0" />

          {/* Contenido con des-skew para mantenerse recto y legible */}
          <div
            class:list={[
              "relative z-10 flex items-center min-w-0 skew-x-6 sm:skew-x-12",
              isHalfwidth ? "gap-2 sm:gap-3" : "gap-3 sm:gap-5",
            ]}
          >
            {item.isVip ? (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                class:list={[
                  "shrink-0 text-gym-yellow fill-gym-yellow drop-shadow-sm transition-transform duration-300 group-data-[active=true]:scale-115",
                  isHalfwidth
                    ? "size-5 sm:size-6 md:size-7"
                    : "size-6 sm:size-8 md:size-9",
                ]}
              >
                <path d="M2 19h20v2H2v-2zM2 6l5 4 5-7 5 7 5-4v11H2V6z" />
              </svg>
            ) : (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                class:list={[
                  "shrink-0 text-gym-yellow fill-gym-yellow drop-shadow-sm transition-transform duration-300 group-data-[active=true]:scale-115",
                  isHalfwidth
                    ? "size-5 sm:size-6 md:size-7"
                    : "size-6 sm:size-8 md:size-9",
                ]}
              >
                <path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11zM7 11h2v2H7zm4 0h2v2h-2zm4 0h2v2h-2zm-8 4h2v2H7zm4 0h2v2h-2zm4 0h2v2h-2z" />
              </svg>
            )}

            <span
              class:list={[
                "font-sans font-black italic text-white tracking-wider truncate uppercase",
                isHalfwidth
                  ? "text-sm sm:text-base md:text-lg lg:text-xl"
                  : "text-lg sm:text-2xl md:text-3xl",
              ]}
            >
              {item.duration}
            </span>
          </div>
        </div>

        {/* Lado Derecho: Insignia de Precio en Amarillo Gym Tabaku */}
        <div
          class:list={[
            "flex items-center justify-center sm:justify-start shrink-0 transition-colors duration-200 group-data-[active=true]:bg-primary-500 group-data-[active=false]:bg-primary-400",
            isHalfwidth
              ? "w-[34%] sm:w-[38%] pl-3 sm:pl-5 pr-2 sm:pr-4 py-2.5 sm:py-3"
              : "w-[32%] sm:w-[38%] md:w-[36%] pl-4 sm:pl-7 md:pl-9 pr-3 sm:pr-6 py-3 sm:py-4 md:py-4.5",
          ]}
        >
          {/* Precio con des-skew para mantenerse recto y legible */}
          <span
            class:list={[
              "font-sans font-black italic text-secondary-950 tracking-tight whitespace-nowrap skew-x-6 sm:skew-x-12",
              isHalfwidth
                ? "text-sm sm:text-base md:text-lg lg:text-xl"
                : "text-lg sm:text-2xl md:text-3xl",
            ]}
          >
            $ {item.price}
          </span>
        </div>
      </div>
    ))
  }
</div>

<script>
  function initPriceCards() {
    const containers = document.querySelectorAll<HTMLElement>(
      "[data-prices-container]",
    );

    containers.forEach((container) => {
      const cards = Array.from(
        container.querySelectorAll<HTMLElement>("[data-price-card]"),
      );
      const defaultCard = container.querySelector<HTMLElement>(
        "[data-default-active='true']",
      );

      function setActive(targetCard: HTMLElement | null) {
        cards.forEach((card) => {
          const isTarget = card === targetCard;
          card.setAttribute("data-active", isTarget ? "true" : "false");
        });
      }

      // Inicializar con la tarjeta por defecto activa
      setActive(defaultCard);

      // Eventos hover y touch en cada tarjeta
      cards.forEach((card) => {
        card.addEventListener("mouseenter", () => {
          setActive(card);
        });

        // Soporte táctil para móvil / tablet
        card.addEventListener(
          "touchstart",
          () => {
            setActive(card);
          },
          { passive: true },
        );
      });

      // Al salir el cursor del contenedor completo, volver a activar la tarjeta por defecto
      container.addEventListener("mouseleave", () => {
        setActive(defaultCard);
      });
    });
  }

  // Ejecutar en carga inicial y tras transiciones de Astro
  document.addEventListener("astro:page-load", initPriceCards);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPriceCards);
  } else {
    initPriceCards();
  }
</script>
