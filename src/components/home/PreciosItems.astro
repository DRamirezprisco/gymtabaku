---
const prices = [
    {
        price: 70,
        duration: "1 Mes",
    },
    {
        price: 120,
        duration: "2 Meses",
    },
    {
        price: 200,
        duration: "4 Meses",
    },
    {
        price: 290,
        duration: "6 Meses",
    },
    {
        price: 490,
        duration: "1 Año",
    },
];
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 mt-30 z-10">
    {
        prices.map((price) => {
            return (
                <div class="bg-gym-dark-bg-card-hover rounded-md p-6 w-60 h-40 flex flex-col items-center justify-center gap-4 overflow-hidden relative z-0 transition-all duration-500 hover:-translate-y-3 hover:border-gym-yellow border-2 hover:shadow-[0_0_40px_rgba(239,68,68,.25)] cursor-pointer ">
                    <img
                        src="/img/bg/bgclaro.webp"
                        alt=""
                        class="absolute top-0 right-0 h-30 -z-10"
                    />
                    <h2 class="bg-gym-yellow p-4 rounded-md text-2xl font-bold absolute top-4 left-4">
                        ${price.price} <span class="text-xs -ml-0.5">.000</span>
                    </h2>
                    <p class="text-gym-dark-text-primary text-bold text-2xl absolute bottom-6">
                        {price.duration}
                    </p>
                </div>
            );
        })
    }
</div>
