---
import Titulo from "@/components/global/Titulo.astro";
import PreciosItems from "@/components/home/PreciosItems.astro";
---

<section
  class="relative bg-gym-bg bg-[url('/img/bg/bgclaroflip.webp')] bg-cover w-full py-12 sm:py-16 md:py-20 lg:py-24 overflow-hidden"
>
  <div
    data-reveal="fade-up"
    data-reveal-delay="400"
    class="absolute -bottom-10 right-0 w-full pointer-events-none select-none z-0"
  >
    <img
      src="/img/bg/bgcuerdas.webp"
      alt=""
      class="object-cover -rotate-y-180 scale-125 2xl:scale-100 2xl:-bottom-100 w-full opacity-40"
    />
  </div>

  <div
    class="max-w-6xl 2xl:max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 relative z-10"
  >
    <div
      class="bg-secondary-800/10 backdrop-blur-xs rounded-2xl flex flex-col justify-center items-center gap-3 z-20 px-4 sm:px-8 py-6 sm:py-8 max-w-4xl mx-auto shadow-sm"
      data-reveal="fade-up"
    >
      <Titulo title="Precios" />

      <h1
        class="font-bold text-2xl sm:text-3xl md:text-4xl lg:text-3xl xl:text-4xl text-center text-gym-dark-bg-card-hover tracking-tight my-2 sm:my-3"
      >
        Elige el precio que mejor se adapte a ti
      </h1>

      <p
        class="text-gym-text-secondary text-sm sm:text-base lg:text-lg text-center max-w-2xl mx-auto leading-relaxed"
      >
        Da el primer paso hacia una vida más activa y saludable con precios
        accesibles diseñados para ayudarte a alcanzar tus objetivos sin
        complicaciones.
      </p>
    </div>

    <PreciosItems baseDelay={700} />
  </div>
</section>
