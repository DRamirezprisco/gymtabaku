---
import Button from "@/components/global/Button.astro";
const { img, title, subtitle, description, icon, url, active } = Astro.props;
const containerClasses = active
  ? "z-0 md:z-10 md:scale-110 md:shadow-2xl md:group-hover/grid:scale-100 md:group-hover/grid:z-0 md:hover:!scale-110 md:hover:!z-20 hover:border-2 hover:border-gym-yellow"
  : "z-0 md:hover:scale-110 md:hover:z-20 md:hover:shadow-2xl hover:border-2 hover:border-gym-yellow";

const infoClasses = active
  ? "opacity-100 md:group-hover/grid:opacity-0 md:group-hover:!opacity-100"
  : "opacity-100 md:opacity-0 md:group-hover:opacity-100";
---

<div
  class={`relative group w-full rounded-xl overflow-hidden transition-all duration-500 ease-out h-[26rem] sm:h-[28rem] md:h-[30rem] lg:h-[34rem] xl:h-[38rem] ${containerClasses}`}
>
  <img
    src={img}
    alt={title}
    class="w-full h-full object-cover rounded-xl group-hover:scale-110 transition-transform duration-700"
  />

  {/* Sombra de fondo para asegurar legibilidad del texto */}
  <div
    class="absolute inset-0 bg-linear-to-t from-black/95 via-black/40 to-transparent z-0 pointer-events-none"
  >
  </div>

  {/* Tarjeta de información */}
  <div
    class={`absolute bottom-1 sm:bottom-2 left-1 sm:left-2 right-1 sm:right-2 px-3 sm:px-4 pt-3 sm:pt-4 md:pt-3 lg:pt-5 pb-4 sm:pb-5 md:pb-3 lg:pb-6 bg-gym-bg-card-hover/50 backdrop-blur-sm m-2 sm:m-3 md:m-2 lg:m-4 rounded-xl transition-all duration-500 z-10 ${infoClasses}`}
  >
    <div class="flex items-center justify-start gap-2 mb-2">
      {/* Iconos SVG (Se mantienen exactamente igual que tu código original) */}
