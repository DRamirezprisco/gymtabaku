---
import Button from "@/components/global/Button.astro";
import Titulo from "@/components/global/Titulo.astro";
---

<section
  class="relative bg-gym-bg bg-[url('/img/bg/bgclaro1.webp')] bg-cover w-full overflow-hidden py-12 sm:py-16 md:py-20 lg:py-24"
>
  <img
    src="/img/bg/bgyellow.webp"
    alt=""
    aria-hidden="true"
    class="absolute -right-10 -top-10 size-42 sm:size-50 md:size-54 lg:size-50 xl:size-52 2xl:size-84 pointer-events-none"
  />
  <img
    src="/img/bg/bgclarotexture.webp"
    alt=""
    aria-hidden="true"
    class="absolute -right-10 -top-10 size-40 sm:size-48 md:size-52 lg:size-48 xl:size-49 2xl:size-80 pointer-events-none"
  />

  <div
    class="max-w-6xl 2xl:max-w-7xl w-[calc(100%-1.5rem)] sm:w-[calc(100%-2.5rem)] lg:w-full mx-auto px-4 sm:px-6 lg:px-8 flex flex-col lg:flex-row items-center justify-between gap-10 lg:gap-12 relative z-10"
  >
    <!-- Columna Izquierda: Información y Foto Mancuerna -->
    <div data-reveal="fade-right" class="w-full lg:w-7/12 xl:w-1/2">
      <div class="flex flex-col gap-3 text-center lg:text-left">
        <div
          data-reveal="fade-down"
          data-reveal-delay="150"
          class="flex justify-center lg:justify-start"
        >
          <Titulo title="sobre nosotros" />
        </div>
        <h1
          class="my-2 text-2xl sm:text-3xl md:text-4xl lg:text-3xl xl:text-4xl font-bold text-gym-dark-bg-card-hover tracking-tight text-center"
        >
          ¡Más que un gimnasio. <br class="hidden sm:inline" /> Tu hogar para entrenar!
        </h1>

        <div
          class="flex flex-col sm:flex-row items-center sm:items-start gap-4 sm:gap-6 mt-4 sm:mt-6"
        >
          <img
            src="/img/aboutdos.webp"
            alt="Mancuerna en el suelo del gimnasio"
            class="w-full max-w-xs sm:w-44 md:w-80 lg:w-40 xl:w-56 h-48 sm:h-72 md:h-80 object-cover rounded-xl shadow-md shrink-0"
          />
          <div
            class="flex flex-col justify-between h-full text-center sm:text-left"
          >
            <p
              class="text-sm sm:text-base lg:text-lg text-gym-text-secondary leading-relaxed mt-2"
            >
              Aquí no eres un número más. Somos una comunidad que comparte el
              esfuerzo, la disciplina y el deseo de mejorar cada día. <strong
                class="text-secondary-950 font-bold"
                >¡Entrenamos juntos, crecemos juntos!.</strong
              >
            </p>
            <p
              class="text-sm sm:text-base lg:text-lg text-gym-text-secondary leading-relaxed mt-3 sm:mt-4"
            >
              Entrena en un espacio cómodo, con el acompañamiento de
              profesionales que realmente se preocupan por tu progreso.
            </p>
            <div class="pt-6 sm:pt-8 flex justify-center sm:justify-start">
              <Button text="horarios" url="/horarios" />
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Columna Derecha: Composición Gráfica con Atletas -->
    <div
      data-reveal="fade-left"
      data-reveal-delay="450"
      class="hidden lg:flex relative w-full lg:w-5/12 xl:w-1/2 items-center justify-center pt-8 sm:pt-10 lg:pt-0"
    >
      <!-- Franjas diagonales amarillas de fondo: se expanden desde el centro hacia afuera -->
      <div
        class="flex w-[110%] absolute inset-0 justify-center items-center pointer-events-none"
      >
        <div
          class="w-full -rotate-45 -translate-x-12 sm:-translate-x-20 -translate-y-4"
        >
          <div
            data-reveal="expand-line"
            data-reveal-delay="800"
            class="bg-gym-yellow h-1.5 sm:h-2 w-full origin-center"
          >
          </div>
        </div>
      </div>
      <div
        class="flex w-[110%] absolute inset-0 justify-center items-center pointer-events-none"
      >
        <div
          class="w-full -rotate-45 -translate-x-8 sm:-translate-x-15 translate-y-2"
        >
          <div
            data-reveal="expand-line"
            data-reveal-delay="950"
            class="bg-gym-yellow h-0.5 sm:h-1 w-full origin-center"
          >
          </div>
        </div>
      </div>

      <!-- Contenedor con silueta de fondo oscuro, logo flotante con órbita continua y foto de los atletas -->
      <div
        class="relative after:content-[''] after:absolute after:bg-gym-bg-card-hover/95 after:rounded-xl after:mt-10 sm:after:mt-16 after:mr-12 sm:after:mr-24 lg:after:mr-32 after:-ml-4 sm:after:-ml-6 after:h-4/5 sm:after:h-5/6 after:w-full after:-z-10 after:top-2 sm:after:-top-1"
      >
        <!-- Logo del gym: aparece de último tras crecer las líneas amarillas y arranca su órbita continua -->
        <div
          data-reveal="zoom-in"
          data-reveal-delay="1200"
          class="absolute top-20 sm:top-28 md:top-36 lg:top-40 -left-6 sm:-left-10 md:-left-14 lg:-left-16 z-10 pointer-events-none select-none"
        >
          <img
            src="/img/logo.webp"
            alt="logo gym tabaku"
            class="animate-orbit-gentle size-14 sm:size-18 md:size-20 lg:size-22 xl:size-26 drop-shadow-xl"
          />
        </div>
        <img
          src="/img/about.webp"
          alt="Entrenadores Gym Tabaku"
          class="w-auto max-h-72 sm:max-h-96 md:max-h-[28rem] lg:max-h-[32rem] xl:max-h-[36rem] 2xl:max-h-[40rem] object-contain"
        />
      </div>
    </div>
  </div>
</section>
