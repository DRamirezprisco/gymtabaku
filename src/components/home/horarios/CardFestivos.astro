---
// CardFestivos.astro
---

<div
  class="group bg-black/30 backdrop-blur-md border border-white/15 rounded-xl p-6 sm:p-8 transition-all duration-500 hover:-translate-y-2 hover:border-gym-yellow hover:shadow-[0_0_35px_rgba(255,204,0,0.2)] w-full h-full flex flex-col justify-between"
>
  <h3
    class="text-2xl sm:text-3xl text-gym-dark-text-primary font-serif mb-6 sm:mb-8 flex items-center gap-3"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      width="128"
      height="128"
      class="size-8 sm:size-10 shrink-0"
    >
      <path
        fill="#ffde4d"
        d="M7.91 14.34H5a3 3 0 0 1-2.33-1.12a.26.26 0 0 0-.34-.05A5.5 5.5 0 1 0 11 17.66a5.44 5.44 0 0 0-1.25-3.47a.23.23 0 0 0-.26-.08a6 6 0 0 1-1.58.23M7 3.34a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0-5 0"
      ></path>
      <path
        fill="#ffde4d"
        d="M24 4.84a1.5 1.5 0 0 0-3 0v4a1.5 1.5 0 0 1-1.5 1.5h-2.23a1 1 0 0 1-.55-.17l-3.86-2.56a1.5 1.5 0 0 0-1.86.08l-2.13 1.8a1.53 1.53 0 0 1-1 .35H5a1.5 1.5 0 0 0 0 3h2.91a4.46 4.46 0 0 0 2.88-1.05l1.15-.95a.26.26 0 0 1 .29 0l2.31 1.5a1 1 0 0 1 .46.84v8.5a1.5 1.5 0 0 0 3 0v-8.09a.25.25 0 0 1 .25-.25h1.25a4.51 4.51 0 0 0 4.5-4.5Z"
      ></path>
    </svg>
    <span>Festivos</span>
  </h3>

  <div class="space-y-6 sm:space-y-7">
    <div
      class="flex justify-between items-center border-b border-white/10 pb-4"
    >
      <div class="flex items-center gap-3">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="128"
          height="128"
          viewBox="0 0 48 48"
          class="size-5 shrink-0"
        >
          <g fill="none" stroke-linejoin="round" stroke-width="4">
            <path
              fill="var(--color-primary-50)"
              stroke="var(--color-secondary-800)"
              d="M24 44C35.0457 44 44 35.0457 44 24C44 12.9543 35.0457 4 24 4C12.9543 4 4 12.9543 4 24C4 35.0457 12.9543 44 24 44Z"
            ></path>
            <path
              stroke="var(--color-secondary-800)"
              stroke-linecap="round"
              d="M24.0084 12.0001L24.0072 24.0089L32.4866 32.4883"></path>
          </g>
        </svg>
        <span
          class="text-gym-dark-text-secondary font-semibold text-sm sm:text-base"
        >
          08:00 AM
        </span>
      </div>
      <span class="text-gym-dark-text-secondary text-sm sm:text-base">
        Apertura
      </span>
    </div>

    <div
      class="flex justify-between items-center border-b border-white/10 pb-4"
    >
      <div class="flex items-center gap-3">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="128"
          height="128"
          viewBox="0 0 48 48"
          class="size-5 shrink-0"
        >
          <g fill="none" stroke-linejoin="round" stroke-width="4">
            <path
              fill="var(--color-primary-50)"
              stroke="var(--color-secondary-800)"
              d="M24 44C35.0457 44 44 35.0457 44 24C44 12.9543 35.0457 4 24 4C12.9543 4 4 12.9543 4 24C4 35.0457 12.9543 44 24 44Z"
            ></path>
            <path
              stroke="var(--color-secondary-800)"
              stroke-linecap="round"
              d="M24.0084 12.0001L24.0072 24.0089L32.4866 32.4883"></path>
          </g>
        </svg>
        <span
          class="text-gym-dark-text-secondary font-semibold text-sm sm:text-base"
        >
          02:00 PM
        </span>
      </div>
      <span class="text-gym-dark-text-secondary text-sm sm:text-base">
        Cierre
      </span>
    </div>
  </div>
</div>
