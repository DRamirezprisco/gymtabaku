---
// CardDomingo.astro
---

<div
  class="group bg-black/30 backdrop-blur-md border border-white/15 rounded-xl p-6 sm:p-8 transition-all duration-500 hover:-translate-y-2 hover:border-gym-yellow hover:shadow-[0_0_35px_rgba(255,204,0,0.2)] w-full h-full flex flex-col justify-between"
>
  <h3
    class="text-2xl sm:text-3xl text-gym-dark-text-primary font-serif mb-6 sm:mb-8 flex items-center gap-3"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-10 sm:size-12 shrink-0 stroke-gym-yellow"
    >
      <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
      <path d="M10 3a1 1 0 1 0 2 0a1 1 0 0 0 -2 0"></path>
      <path d="M3 14l4 1l.5 -.5"></path>
      <path d="M12 18v-3l-3 -2.923l.75 -5.077"></path>
      <path d="M6 10v-2l4 -1l2.5 2.5l2.5 .5"></path>
      <path d="M21 22a1 1 0 0 0 -1 -1h-16a1 1 0 0 0 -1 1"></path>
      <path d="M18 21l1 -11l2 -1"></path>
    </svg>
    <span>Domingo</span>
  </h3>

  <div class="space-y-6 sm:space-y-7">
    <div
      class="flex justify-between items-center border-b border-white/10 pb-4"
    >
      <div class="flex items-center gap-3">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="128"
          height="128"
          viewBox="0 0 48 48"
          class="size-5 shrink-0"
        >
          <g fill="none" stroke-linejoin="round" stroke-width="4">
            <path
              fill="var(--color-primary-50)"
              stroke="var(--color-secondary-800)"
              d="M24 44C35.0457 44 44 35.0457 44 24C44 12.9543 35.0457 4 24 4C12.9543 4 4 12.9543 4 24C4 35.0457 12.9543 44 24 44Z"
            ></path>
            <path
              stroke="var(--color-secondary-800)"
              stroke-linecap="round"
              d="M24.0084 12.0001L24.0072 24.0089L32.4866 32.4883"></path>
          </g>
        </svg>
        <span
          class="text-gym-dark-text-secondary font-semibold text-sm sm:text-base"
        >
          08:00 AM
        </span>
      </div>
      <span class="text-gym-dark-text-secondary text-sm sm:text-base">
        Apertura
      </span>
    </div>

    <div
      class="flex justify-between items-center border-b border-white/10 pb-4"
    >
      <div class="flex items-center gap-3">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="128"
          height="128"
          viewBox="0 0 48 48"
          class="size-5 shrink-0"
        >
          <g fill="none" stroke-linejoin="round" stroke-width="4">
            <path
              fill="var(--color-primary-50)"
              stroke="var(--color-secondary-800)"
              d="M24 44C35.0457 44 44 35.0457 44 24C44 12.9543 35.0457 4 24 4C12.9543 4 4 12.9543 4 24C4 35.0457 12.9543 44 24 44Z"
            ></path>
            <path
              stroke="var(--color-secondary-800)"
              stroke-linecap="round"
              d="M24.0084 12.0001L24.0072 24.0089L32.4866 32.4883"></path>
          </g>
        </svg>
        <span
          class="text-gym-dark-text-secondary font-semibold text-sm sm:text-base"
        >
          01:00 PM
        </span>
      </div>
      <span class="text-gym-dark-text-secondary text-sm sm:text-base">
        Cierre
      </span>
    </div>
  </div>
</div>
