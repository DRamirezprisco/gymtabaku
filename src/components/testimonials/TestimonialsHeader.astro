---
import Menu from "@/components/Menu.astro";
import Titulo from "@/components/global/Titulo.astro";
import TestimonialsItems from "@/components/home/TestimonialsItems.astro";
---

<section class="relative bg-black bg-cover w-full overflow-hidden">
    <div class="relative z-10">
        <Menu />

        <main
            class="max-w-6xl 2xl:max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 pt-4 sm:pt-6"
        >
            <header
                class="flex flex-col gap-2.5 sm:gap-3 text-center max-w-3xl mx-auto mt-6 sm:mt-10 md:mt-12"
                data-reveal="fade-up"
                data-reveal-delay="0"
            >
                <div class="mb-1">
                    <Titulo title="Nuestra Comunidad" isdark />
                </div>
                <h1
                    class="my-2 text-2xl sm:text-3xl md:text-4xl lg:text-3xl xl:text-4xl font-bold text-gym-dark-text-primary tracking-tight text-center"
                >
                    Historias de esfuerzo <br />
                    <span class="text-primary-500 block"
                        >Experiencias reales</span
                    >
                </h1>
                <p
                    class="text-center text-sm sm:text-base lg:text-lg text-gym-dark-text-secondary max-w-3xl mx-auto leading-relaxed"
                >
                    Cada historia, cada esfuerzo y cada logro hacen parte de
                    nuestra familia, conoce sus historias.
                </p>
            </header>
        </main>

        <div class="relative w-full mx-auto pt-4 sm:pt-6 pb-6 sm:pb-10">
            <TestimonialsItems />
        </div>
    </div>
</section>
