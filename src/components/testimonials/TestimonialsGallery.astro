const isActive = true;
---

<section
    class="relative bg-gym-bg bg-[url('/img/bg/bgclaro1.webp')] bg-cover w-full overflow-hidden min-h-screen p-10"
>
    <div
        class:list={[
            "gallery-title hidden mt-15 sm:text-4xl md:text-2xl xl:text-3xl font-serif text-gym-text-primary tracking-wide text-center uppercase [.is-active&]:block",
            { "is-active": isActive },
        ]}
    >
        <Titulo title={title} />
    </div>

    <div
        id="filters-testimonials"
        class="flex items-center justify-center py-4 md:py-8 flex-wrap gap-8"
    >
        {
            galeryFilters.map((filter, index) => (
                <Button
                    text={filter.name}
                    url={filter.filter}
                    black={index !== 0}
                />
            ))
        }
    </div>

    <div class="grid gap-4 w-full md:max-w-5xl mx-auto">
        <div>
            <img
                class="h-auto max-w-full rounded-base"
                src="https://flowbite.s3.amazonaws.com/docs/gallery/featured/image.jpg"
                alt=""
            />
        </div>
        <div class="grid grid-cols-5 gap-4">
