---
import Titulo from "@/components/global/Titulo.astro";
import {
    COMMUNITY_EVENTS,
    type EventItem,
} from "@/components/constants/testimonials";

interface Props {
    title?: string;
}

const { title = "Nuestros Eventos" } = Astro.props;

const events: EventItem[] = COMMUNITY_EVENTS;
---

<section
    class="relative bg-gym-bg bg-[url('/img/bg/bgclaro1.webp')] bg-cover w-full overflow-hidden py-12 sm:py-16 md:py-20 px-4 sm:px-6 lg:px-8"
>
    <!-- Fondo decorativo sutil -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden select-none z-0">
        <img
            src="/img/bg/fondoyellow.webp"
            alt=""
            class="w-full h-auto object-cover object-bottom opacity-35 sm:opacity-50"
            data-reveal="fade-in"
            data-reveal-delay="100"
        />
        <div class="absolute inset-0 w-full h-full" data-reveal="fade-up" data-reveal-delay="200">
            <img
                src="/img/bg/bgcuerdas.webp"
                alt=""
                class="absolute object-cover scale-125 2xl:scale-100 -bottom-10 left-0 w-full pointer-events-none select-none opacity-40"
            />
        </div>
    </div>

    <div class="max-w-6xl 2xl:max-w-7xl mx-auto w-full relative z-10">
        <!-- Título de la Sección -->
        <div class="text-center mb-6 sm:mb-8 md:mb-10" data-reveal="fade-up" data-reveal-delay="100">
            <Titulo title={title} />
            <h1
                class="font-bold text-2xl sm:text-3xl md:text-4xl lg:text-3xl xl:text-4xl text-center text-gym-dark-bg-card-hover tracking-tight my-2 sm:my-3"
            >
                ¡Momentos inolvidables, siempre juntos!
            </h1>
            <p
                class="mt-2 text-sm sm:text-base lg:text-lg text-gym-text-secondary max-w-2xl mx-auto leading-relaxed"
            >
                Celebramos cada fecha especial compartiendo nuestra pasión por el movimiento, la salud y la unión en familia.
            </p>
        </div>

        <!-- Botones de Filtro de Eventos -->
        <div
            id="filters-testimonials"
            class="flex items-center justify-center flex-wrap gap-2 sm:gap-3 md:gap-4 mb-6 sm:mb-8 md:mb-10"
            data-reveal="fade-up"
            data-reveal-delay="300"
        >
            {
                events.map((event, index) => (
                    <button
                        type="button"
                        data-event-filter={event.id}
                        class:list={[
                            "event-filter-btn px-4 sm:px-5 py-2 sm:py-2.5 rounded-xl font-serif text-xs sm:text-sm md:text-base tracking-wider transition-all duration-200 cursor-pointer select-none border-2",
                            index === 0
                                ? "is-active bg-primary-500 border-primary-500 text-secondary-950 font-bold shadow-md scale-105"
                                : "bg-secondary-950/80 hover:bg-secondary-900 border-white/10 hover:border-gym-yellow text-white font-medium hover:scale-102",
                        ]}
                    >
                        {event.name}
                    </button>
                ))
            }
        </div>

        <!-- Galerías de cada Evento -->
        <div
            id="eventsGalleriesContainer"
            class="w-full max-w-5xl mx-auto"
            data-reveal="fade-up"
            data-reveal-delay="500"
        >
            {
                events.map((event, index) => (
                    <div
                        data-event-gallery={event.id}
                        class:list={[
                            "event-gallery-item transition-all duration-500",
                            index === 0 ? "block opacity-100" : "hidden opacity-0",
                        ]}
                    >
                        <!-- Foto Destacada Principal -->
                        <div class="relative w-full aspect-video sm:aspect-[16/9] md:aspect-[21/9] max-h-[460px] rounded-2xl overflow-hidden shadow-2xl border border-white/10 bg-secondary-900 group">
                            <img
                                data-featured-img
                                src={event.featured.src}
                                alt={event.featured.alt}
                                class="w-full h-full object-cover object-center transition-all duration-300 group-hover:scale-102"
                                loading="lazy"
                            />
                            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent pointer-events-none" />
                            <div class="absolute bottom-3 left-3 sm:bottom-5 sm:left-6 right-3 sm:right-6 pointer-events-none">
                                <span class="bg-primary-500 text-secondary-950 font-bold text-xs sm:text-sm uppercase tracking-wider px-2.5 py-1 rounded-md shadow-md inline-block mb-1.5">
                                    {event.name}
                                </span>
                                <h3
                                    data-featured-caption
                                    class="font-serif text-base sm:text-xl md:text-2xl font-bold text-white tracking-tight drop-shadow-md"
                                >
                                    {event.featured.alt}
                                </h3>
                            </div>
                        </div>

                        <!-- Miniaturas de Fotos: 2 cols en móvil, 3 en sm, 5 en md+ -->
                        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-2.5 sm:gap-3 md:gap-4 mt-3 sm:mt-4 md:mt-5">
                            {event.thumbnails.map((thumb, tIdx) => (
                                <button
                                    type="button"
                                    data-thumb-src={thumb.src}
                                    data-thumb-alt={thumb.alt}
                                    class:list={[
                                        "thumb-btn relative aspect-square rounded-xl overflow-hidden cursor-pointer shadow-md transition-all duration-200 border-2 select-none group",
                                        tIdx === 0
                                            ? "border-gym-yellow ring-2 ring-gym-yellow/50 scale-102"
                                            : "border-transparent hover:border-gym-yellow/70 hover:scale-105",
                                    ]}
                                    aria-label={`Ver ${thumb.alt}`}
                                >
                                    <img
                                        src={thumb.src}
                                        alt={thumb.alt}
                                        class="w-full h-full object-cover object-center transition-transform duration-300 group-hover:scale-110"
                                        loading="lazy"
                                    />
                                    <div class="absolute inset-0 bg-black/20 group-hover:bg-transparent transition-colors duration-200" />
                                </button>
                            ))}
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<script>
    function initTestimonialsGallery() {
        const filterButtons = document.querySelectorAll<HTMLButtonElement>(
            "[data-event-filter]",
        );
        const galleryItems = document.querySelectorAll<HTMLElement>(
            "[data-event-gallery]",
        );

        if (!filterButtons.length || !galleryItems.length) return;

        // 1. Manejador de Pestañas de Eventos
        filterButtons.forEach((btn) => {
            btn.addEventListener("click", () => {
                const targetFilter = btn.getAttribute("data-event-filter");
                if (!targetFilter) return;

                // Actualizar estado de los botones
                filterButtons.forEach((b) => {
                    const isMatch =
                        b.getAttribute("data-event-filter") === targetFilter;
                    if (isMatch) {
                        b.classList.add(
                            "is-active",
                            "bg-primary-500",
                            "border-primary-500",
                            "text-secondary-950",
                            "font-bold",
                            "shadow-md",
                            "scale-105",
                        );
                        b.classList.remove(
                            "bg-secondary-950/80",
                            "hover:bg-secondary-900",
                            "border-white/10",
                            "hover:border-gym-yellow",
                            "text-white",
                            "font-medium",
                            "hover:scale-102",
                        );
                    } else {
                        b.classList.remove(
                            "is-active",
                            "bg-primary-500",
                            "border-primary-500",
                            "text-secondary-950",
                            "font-bold",
                            "shadow-md",
                            "scale-105",
                        );
                        b.classList.add(
                            "bg-secondary-950/80",
                            "hover:bg-secondary-900",
                            "border-white/10",
                            "hover:border-gym-yellow",
                            "text-white",
                            "font-medium",
                            "hover:scale-102",
                        );
                    }
                });

                // Actualizar la galería visible
                galleryItems.forEach((gallery) => {
                    const isMatch =
                        gallery.getAttribute("data-event-gallery") ===
                        targetFilter;
                    if (isMatch) {
                        gallery.classList.remove("hidden");
                        gallery.classList.add("block");
                        requestAnimationFrame(() => {
                            gallery.classList.remove("opacity-0");
                            gallery.classList.add("opacity-100");
                        });
                    } else {
                        gallery.classList.add("hidden", "opacity-0");
                        gallery.classList.remove("block", "opacity-100");
                    }
                });
            });
        });

        // 2. Manejador de Clic en Miniaturas para cambiar la foto destacada
        galleryItems.forEach((gallery) => {
            const featuredImg = gallery.querySelector<HTMLImageElement>(
                "[data-featured-img]",
            );
            const featuredCaption = gallery.querySelector<HTMLElement>(
                "[data-featured-caption]",
            );
            const thumbButtons =
                gallery.querySelectorAll<HTMLButtonElement>("[data-thumb-src]");

            if (!featuredImg || !thumbButtons.length) return;

            thumbButtons.forEach((thumbBtn) => {
                thumbBtn.addEventListener("click", () => {
                    const newSrc = thumbBtn.getAttribute("data-thumb-src");
                    const newAlt = thumbBtn.getAttribute("data-thumb-alt");
                    if (!newSrc) return;

                    // Suave transición de desvanecimiento
                    featuredImg.style.opacity = "0.3";
                    featuredImg.style.transform = "scale(0.98)";

                    setTimeout(() => {
                        featuredImg.src = newSrc;
                        if (newAlt) {
                            featuredImg.alt = newAlt;
                            if (featuredCaption)
                                featuredCaption.textContent = newAlt;
                        }
                        featuredImg.style.opacity = "1";
                        featuredImg.style.transform = "scale(1)";
                    }, 150);

                    // Resaltar miniatura activa
                    thumbButtons.forEach((t) => {
                        if (t === thumbBtn) {
                            t.classList.add(
                                "border-gym-yellow",
                                "ring-2",
                                "ring-gym-yellow/50",
                                "scale-102",
                            );
                            t.classList.remove(
                                "border-transparent",
                                "hover:border-gym-yellow/70",
                                "hover:scale-105",
                            );
                        } else {
                            t.classList.remove(
                                "border-gym-yellow",
                                "ring-2",
                                "ring-gym-yellow/50",
                                "scale-102",
                            );
                            t.classList.add(
                                "border-transparent",
                                "hover:border-gym-yellow/70",
                                "hover:scale-105",
                            );
                        }
                    });
                });
            });
        });
    }

    document.addEventListener("astro:page-load", initTestimonialsGallery);
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initTestimonialsGallery);
    } else {
        initTestimonialsGallery();
    }
</script>
