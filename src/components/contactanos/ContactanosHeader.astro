---
import Menu from "@/components/Menu.astro";
import Titulo from "@/components/global/Titulo.astro";
import ContactanosForm from "@/components/contactanos/ContactanosForm.astro";
---

<section class="relative bg-black bg-cover w-full overflow-hidden min-h-screen">
  <!-- Fondo decorativo con protección contra scroll horizontal -->
  <img
    src="/img/bg/intento4.jpg"
    alt=""
    class="absolute -right-80 sm:-right-85 lg:-right-70 top-0 w-auto object-cover opacity-70 sm:opacity-80 h-full pointer-events-none select-none max-w-none"
  />

  <div class="relative z-10">
    <Menu />

    <main
      class="max-w-6xl 2xl:max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 sm:py-12 md:py-16"
    >
      <header class="max-w-3xl mx-auto text-center mb-8 sm:mb-12">
        <div class="mb-1">
          <Titulo title="Estamos para ti" isdark />
        </div>
        <h1
          class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl text-white font-bold tracking-tight leading-tight mt-2 sm:mt-3"
        >
          ¡Entrena con fuerza. <br class="hidden sm:inline" /> Crece en familia!
        </h1>
        <p
          class="text-sm sm:text-base lg:text-lg text-gym-dark-text-secondary leading-relaxed max-w-2xl mx-auto mt-2 sm:mt-3 font-normal"
        >
          ¿Tienes dudas sobre nuestros planes, horarios o entrenamientos
          personalizados? Escríbenos y comencemos juntos tu transformación.
        </p>
      </header>
      <ContactanosForm />
    </main>
  </div>
</section>
