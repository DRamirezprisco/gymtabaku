---
import Menu from "@/components/Menu.astro";
import Titulo from "@/components/global/Titulo.astro";
import ButtonSkew from "@/components/global/ButtonSkew.astro";
import ContactanosForm from "@/components/contactanos/ContactanosForm.astro";
---

<section class="relative bg-black bg-cover w-full overflow-hidden min-h-screen">
    <img
        src="/img/bg/intento4.jpg"
        alt="fondo de pagina"
        class="absolute -right-70 top-0 w-auto object-cover opacity-80 h-full"
    />

    <div class="relative z-10">
        <Menu />

        <main
            class="max-w-sm sm:max-w-lg md:max-w-2xl lg:max-w-4xl xl:max-w-5xl 2xl:max-w-7xl mx-auto w-full px-4 py-12"
        >
            <header
                class="max-w-md sm:max-w-lg md:max-w-4xl lg:max-w-6xl xl:max-w-7xl mx-auto text-center mb-12 sm:mb-16"
            >
                <Titulo title="Estamos para ti" isdark />
                <h3
                    class="font-bold text-base sm:text-lg md:text-xl lg:text-2xl text-secondary-50 pt-3"
                >
                    ¡Entrena con fuerza. Crece en familia!
                </h3>
            </header>
            <ContactanosForm />
        </main>
    </div>
</section>
