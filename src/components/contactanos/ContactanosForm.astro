---
import Button from "@/components/global/Button.astro";
---

<div
    class="relative w-full mx-auto max-w-6xl rounded-3xl bg-linear-to-t from-gym-yellow/30 via-gym-yellow/10 to-transparent backdrop-blur-md border border-white/10 shadow-2xl p-2 sm:p-12 overflow-hidden"
>
    <div class="grid grid-cols-1 lg:grid-cols-2 items-center relative z-10">
        <div class="flex flex-col">
            <h2
                class="text-3xl sm:text-4xl font-extrabold text-white mb-6 tracking-tight"
            >
                Contactanos
            </h2>

            <form
                class="flex flex-col gap-4"
                onsubmit="event.preventDefault();"
            >
                <div class="relative flex items-center">
                    <input
                        type="text"
                        placeholder="Nombre Completo"
                        class="w-full bg-white/10 text-white placeholder-neutral-400 py-3.5 px-4 pr-11 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-400 transition-all border border-transparent focus:border-transparent"
                        required
                    />
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-5 h-5 absolute right-4 text-neutral-400"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"
                        ></path><circle cx="12" cy="7" r="4"></circle></svg
                    >
                </div>

                <div class="relative flex items-center">
                    <input
                        type="email"
                        placeholder="Correo Electronico"
                        class="w-full bg-white/10 text-white placeholder-neutral-400 py-3.5 px-4 pr-11 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-400 transition-all border border-transparent focus:border-transparent"
                        required
                    />
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-5 h-5 absolute right-4 text-neutral-400"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><rect width="20" height="16" x="2" y="4" rx="2"
                        ></rect><path
                            d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"
                        ></path></svg
                    >
                </div>

                <div class="relative flex items-center">
                    <input
                        type="tel"
                        placeholder="Telefono"
                        class="w-full bg-white/10 text-white placeholder-neutral-400 py-3.5 px-4 pr-11 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-400 transition-all border border-transparent focus:border-transparent"
                    />
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-5 h-5 absolute right-4 text-neutral-400"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path
                            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                        ></path></svg
                    >
                </div>

                <div class="relative flex items-start">
                    <textarea
                        rows="3"
                        placeholder="¿Tienes alguna pregunta? Escríbenos, queremos conocerte y acompañarte en tu camino..."
                        class="w-full bg-white/10 text-white placeholder-neutral-400 py-10 px-4 pr-11 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-400 transition-all border border-transparent focus:border-transparent resize-none"
                    ></textarea>
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-5 h-5 absolute right-4 top-3.5 text-neutral-400"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M12 20h9"></path><path
                            d="16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"
                        ></path></svg
                    >
                </div>

                <div class="flex justify-center items-center">
                    <Button text="Enviar Mensaje" variant="primary" />
                </div>
            </form>
        </div>

        <img
            src="/img/personaje.webp"
            alt="Entrenador de gimnasio"
            class="absolute object-cover h-150 opacity-40 lg:opacity-100 -bottom-12 -right-20 -z-10"
        />
    </div>
</div>
