---
// ContactanosForm.astro
import { SITE_CONFIG } from "@/components/constants/site";

const whatsappNumber = SITE_CONFIG.contact.whatsappNumber;
---

<div
  class="relative w-full mx-auto max-w-6xl rounded-2xl sm:rounded-3xl bg-secondary-950/80 bg-linear-to-t from-gym-yellow/20 via-gym-yellow/5 to-transparent backdrop-blur-sm border border-white/10 shadow-2xl p-5 sm:p-8 md:p-10 lg:p-12 overflow-hidden"
>
  <div
    class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center relative z-10"
  >
    <!-- Columna Izquierda: Formulario -->
    <div class="lg:col-span-7 flex flex-col">
      <h2
        class="font-serif text-2xl sm:text-3xl lg:text-4xl font-black text-white mb-2 tracking-tight uppercase"
      >
        Envíanos un mensaje
      </h2>
      <p
        class="text-xs sm:text-sm text-gym-dark-text-secondary mb-6 font-medium"
      >
        Déjanos tus datos y nos pondremos en contacto contigo a la brevedad.
      </p>

      <form id="contactForm" class="flex flex-col gap-3.5 sm:gap-4">
        <!-- Campo Nombre -->
        <div class="relative flex items-center">
          <input
            type="text"
            name="nombre"
            id="contactNombre"
            placeholder="Nombre Completo"
            class="w-full bg-white/10 text-white placeholder-neutral-400 py-3.5 px-4 pr-11 rounded-xl text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-primary-400 transition-all border border-white/5 focus:border-transparent"
            required
          />
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="size-5 absolute right-4 text-neutral-400 pointer-events-none"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </div>

        <!-- Campo Correo -->
        <div class="relative flex items-center">
          <input
            type="email"
            name="email"
            id="contactEmail"
            placeholder="Correo Electrónico"
            class="w-full bg-white/10 text-white placeholder-neutral-400 py-3.5 px-4 pr-11 rounded-xl text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-primary-400 transition-all border border-white/5 focus:border-transparent"
            required
          />
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="size-5 absolute right-4 text-neutral-400 pointer-events-none"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
        </div>

        <!-- Campo Teléfono -->
        <div class="relative flex items-center">
          <input
            type="tel"
            name="telefono"
            id="contactTelefono"
            placeholder="Teléfono / WhatsApp"
            class="w-full bg-white/10 text-white placeholder-neutral-400 py-3.5 px-4 pr-11 rounded-xl text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-primary-400 transition-all border border-white/5 focus:border-transparent"
          />
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="size-5 absolute right-4 text-neutral-400 pointer-events-none"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
            ></path>
          </svg>
        </div>

        <!-- Campo Mensaje -->
        <div class="relative flex items-start">
          <textarea
            name="mensaje"
            id="contactMensaje"
            rows="4"
            placeholder="¿Tienes alguna pregunta? Escríbenos, queremos conocerte y acompañarte en tu camino..."
            class="w-full bg-white/10 text-white placeholder-neutral-400 py-3.5 px-4 pr-11 rounded-xl text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-primary-400 transition-all border border-white/5 focus:border-transparent resize-none min-h-[120px]"
            required></textarea>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="size-5 absolute right-4 top-3.5 text-neutral-400 pointer-events-none"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 20h9"></path>
            <path d="16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"
            ></path>
          </svg>
        </div>

        <!-- Mensaje de Estado / Notificación -->
        <div
          id="formStatusMessage"
          class="hidden p-3.5 rounded-xl bg-primary-500/20 border border-gym-yellow text-gym-yellow text-sm font-semibold text-center transition-all"
        >
          ¡Mensaje recibido! Abriendo WhatsApp para conectar contigo...
        </div>

        <!-- Botón de Envío Brutalista Accesible -->
        <div class="flex justify-center sm:justify-start items-center pt-2">
          <button
            type="submit"
            class="relative inline-flex items-center justify-center font-serif tracking-wider text-sm sm:text-base lg:text-lg px-6 sm:px-8 py-3 sm:py-3.5 min-w-44 sm:min-w-52 bg-primary-500 hover:bg-primary-400 text-secondary-950 border-2 sm:border-3 border-primary-500 hover:border-primary-400 font-black uppercase transition-all duration-200 cursor-pointer shadow-xl
                        before:content-[''] before:w-full before:h-full before:absolute before:top-0 before:left-0 before:border-2 sm:before:border-3 before:border-primary-500 hover:before:border-primary-400 before:translate-y-2 before:-translate-x-2 before:transition-transform before:duration-200 hover:before:translate-x-0 hover:before:translate-y-0 active:scale-95"
          >
            Enviar Mensaje
          </button>
        </div>
      </form>
    </div>

    <!-- Columna Derecha: Ilustración del Atleta (Desktop) -->
    <img
      src="/img/personaje.webp"
      alt="Entrenador Gym Tabaku"
      class="hidden lg:block absolute -right-23 -bottom-20 h-160 object-cover drop-shadow-[0_20px_40px_rgba(0,0,0,0.8)]"
      loading="lazy"
    />
    <div
      class="hidden lg:flex lg:col-span-5 items-end justify-center relative w-full h-full min-h-110 pointer-events-none select-none"
    >
    </div>
  </div>
</div>

<script define:vars={{ whatsappNumber }}>
  function initContactForm() {
    const form = document.getElementById(
      "contactForm",
    ) as HTMLFormElement | null;
    const statusMessage = document.getElementById("formStatusMessage");

    if (!form) return;

    form.addEventListener("submit", (e) => {
      e.preventDefault();

      const nombreInput = document.getElementById(
        "contactNombre",
      ) as HTMLInputElement | null;
      const emailInput = document.getElementById(
        "contactEmail",
      ) as HTMLInputElement | null;
      const telefonoInput = document.getElementById(
        "contactTelefono",
      ) as HTMLInputElement | null;
      const mensajeInput = document.getElementById(
        "contactMensaje",
      ) as HTMLTextAreaElement | null;

      const nombre = nombreInput?.value.trim() || "";
      const email = emailInput?.value.trim() || "";
      const telefono = telefonoInput?.value.trim() || "";
      const mensaje = mensajeInput?.value.trim() || "";

      if (!nombre || !email || !mensaje) return;

      // Mostrar notificación de éxito
      if (statusMessage) {
        statusMessage.textContent =
          "¡Gracias por escribirnos! Abriendo WhatsApp con tus datos...";
        statusMessage.classList.remove("hidden");
      }

      // Construir mensaje amigable para WhatsApp
      const textLines = [
        `¡Hola Gym Tabaku!`,
        `Mi nombre es: ${nombre}`,
        `Correo: ${email}`,
        telefono ? `Teléfono: ${telefono}` : null,
        `Consulta: ${mensaje}`,
      ]
        .filter(Boolean)
        .join("\n");

      const waUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(textLines)}`;

      // Resetear formulario
      form.reset();

      // Abrir WhatsApp tras un breve instante
      setTimeout(() => {
        window.open(waUrl, "_blank");
      }, 600);
    });
  }

  document.addEventListener("astro:page-load", initContactForm);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initContactForm);
  } else {
    initContactForm();
  }
</script>
