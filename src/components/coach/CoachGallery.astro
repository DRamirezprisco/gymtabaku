---
import CoachGalleryItem from "@/components/coach/CoachGalleryItem.astro";

interface HeaderCoaches {
  name?: string;
  role?: string;
  img?: string;
  imgHover?: string;
}

interface DescriptionCoaches {
  tittle?: string;
  subTittle?: string;
  description?: string;
  description2?: string;
  description3?: string;
  img?: string;
  wallpaperSrc?: string;
}

interface GalleryCoaches {
  img?: string;
  alt?: string;
}

interface Coach {
  header: HeaderCoaches;
  description: DescriptionCoaches;
  gallery: GalleryCoaches[];
}

interface Props {
  Coaches: Coach[];
  activeIndex?: number;
}

const { Coaches, activeIndex = 0 } = Astro.props;
---

<style>
  /* Triángulo diagonal superior izquierdo */
  .wedge-top-left {
    clip-path: polygon(0 0, 100% 100%, 0 100%);
  }
  /* Triángulo diagonal inferior derecho */
  .wedge-bottom-right {
    clip-path: polygon(0 100%, 100% 0, 100% 100%);
  }
</style>

<section
  class="relative bg-gym-bg bg-[url('/img/bg/bgclaroflip.webp')] bg-cover w-full py-8 sm:py-12 md:py-16 overflow-hidden flex items-center justify-center"
>
  <img
    src="/img/bg/bggallery.webp"
    alt="bggallery"
    class="absolute top-0 left-0 w-full h-full object-cover object-left pointer-events-none select-none"
  />

  <div id="coachGalleriesContainer" class="relative z-20 w-full">
    {
      Coaches.map((coach, index) => (
        <CoachGalleryItem
          gallery={coach.gallery}
          isActive={index === activeIndex}
          index={index}
        />
      ))
    }
  </div>
</section>
