---
import CoachDescriptionItems from "@/components/coach/CoachDescriptionItems.astro";
import type { Coach } from "@/components/constants/coaches";

interface Props {
  Coaches: Coach[];
  activeIndex?: number;
}

const { Coaches, activeIndex = 0 } = Astro.props;
---

<section
  class="relative bg-black bg-cover w-full overflow-hidden min-h-[500px]"
>
  <img
    src="/img/bg/intento4.jpg"
    alt=""
    aria-hidden="true"
    class="absolute -right-90 sm:-right-75 lg:-right-65 top-0 w-auto object-cover opacity-80 mix-blend-screen h-full pointer-events-none select-none max-w-none"
    data-reveal="fade-in"
    data-reveal-delay="100"
  />

  <div id="coachDescriptionsContainer" class="relative z-10 w-full">
    {
      Coaches.map((coach, index) => (
        <CoachDescriptionItems
          tittle={coach.description.tittle}
          subTittle={coach.description.subTittle}
          description={coach.description.description}
          description2={coach.description.description2}
          description3={coach.description.description3}
          img={coach.description.img}
          wallpaperSrc={coach.description.wallpaperSrc}
          video={coach.description.video}
          isActive={index === activeIndex}
          index={index}
        />
      ))
    }
  </div>
</section>
