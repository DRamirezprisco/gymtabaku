---
import Titulo from "@/components/global/Titulo.astro";

interface Props {
  isActive?: boolean;
  index?: number;
  tittle?: string;
  subTittle?: string;
  description?: string;
  description2?: string;
  description3?: string;
  img?: string;
  wallpaperSrc?: string;
  video?: string;
}

const {
  isActive = false,
  index = 0,
  tittle,
  subTittle,
  description,
  description2,
  description3,
  img,
  video,
} = Astro.props;
---

<div
  data-coach-description={index}
  class:list={[
    "coach-description-item w-full max-w-6xl 2xl:max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 md:py-16 lg:py-20 z-10 transition-opacity duration-300",
    isActive ? "block" : "hidden",
  ]}
>
  <div
    class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-10 lg:gap-12 items-center"
  >
    <!-- Imagen / Video del Profesor: Adaptable en móvil/tablet y columna elegante en desktop -->
    <div
      class="absolute top-20 md:top-15 lg:top-1/2 lg:-translate-y-1/2 -left-10 lg:left-0 w-full"
    >
      <div
        class:list={[
          "coach-media-container relative w-full lg:w-110 xl:w-140 2xl:w-170 rounded-br-2xl rounded-tr-2xl overflow-hidden shadow-2xl bg-secondary-950",
          { "cursor-pointer group/media": !!video },
        ]}
        data-reveal="fade-right"
        data-reveal-delay="200"
      >
        <img
          src={img}
          alt={tittle}
          class="coach-img w-full h-87 md:h-100 lg:h-120 object-cover object-center select-none transition-opacity duration-700"
          loading="lazy"
        />

        {
          video && (
            <video
              data-coach-video
              data-src={video}
              muted
              playsinline
              preload="auto"
              class="coach-video absolute inset-0 w-full h-full object-contain bg-gym-bg-card-hover object-top opacity-0 transition-opacity duration-700 ease-in-out pointer-events-none"
            >
              Tu navegador no soporta el formato de video.
            </video>
          )
        }
      </div>
    </div>

    <div
      class="lg:col-span-5 relative w-full max-w-md sm:max-w-lg lg:max-w-none mx-auto h-100"
    >
    </div>

    <!-- Información y Trayectoria del Profesor -->
    <div
      class="lg:col-span-7 flex flex-col justify-center items-center lg:pl-4 gap-2 sm:gap-3 z-10"
      data-reveal="fade-left"
      data-reveal-delay="400"
    >
      <div class="mb-1">
        <Titulo title={tittle || ""} isdark={true} />
      </div>

      <h1
        class="my-2 text-2xl sm:text-3xl md:text-4xl lg:text-3xl xl:text-4xl font-bold text-gym-dark-text-primary tracking-tight text-center"
      >
        {subTittle}
      </h1>

      <p
        class="text-sm sm:text-base lg:text-lg text-gym-dark-text-secondary leading-relaxed pt-2"
      >
        {description}
      </p>

      <p
        class="text-sm sm:text-base lg:text-lg text-gym-dark-text-secondary leading-relaxed"
      >
        {description2}
      </p>

      <!-- Cita / Compromiso personal del profesor -->
      <div
        class="w-full flex justify-center items-center mt-4 sm:mt-6"
        data-reveal="fade-up"
        data-reveal-delay="600"
      >
        <div
          class="w-full sm:w-11/12 md:w-5/6 p-4 sm:p-5 rounded-xl bg-gym-bg-card/40 border border-gym-yellow/30 shadow-lg backdrop-blur-xs transition-all duration-300 hover:border-gym-yellow hover:shadow-[0_0_30px_rgba(255,204,0,0.2)]"
        >
          <p
            class="text-sm sm:text-base lg:text-lg italic text-secondary-50 text-center leading-relaxed"
          >
            {description3}
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function initCoachVideos() {
    const descriptionItems = document.querySelectorAll<HTMLElement>(
      "[data-coach-description]",
    );

    descriptionItems.forEach((descItem) => {
      const video =
        descItem.querySelector<HTMLVideoElement>("[data-coach-video]");
      if (!video) return;

      const mediaContainer = descItem.querySelector<HTMLElement>(
        ".coach-media-container",
      );

      let isPlaying = false;

      const stopAndReset = () => {
        video.pause();
        video.classList.remove("opacity-100");
        video.classList.add("opacity-0");
        video.currentTime = 0;
        isPlaying = false;
      };

      const playVideo = () => {
        if (!video.dataset.src) return;
        if (!video.src) {
          video.src = video.dataset.src;
        }
        video.currentTime = 0;
        video.muted = true;
        const playPromise = video.play();
        if (playPromise !== undefined) {
          playPromise
            .then(() => {
              isPlaying = true;
            })
            .catch(() => {
              // Si autoplay es bloqueado, la foto permanece visible
            });
        }
      };

      const revealVideo = () => {
        video.classList.remove("opacity-0");
        video.classList.add("opacity-100");
      };

      const hideVideo = () => {
        video.classList.remove("opacity-100");
        video.classList.add("opacity-0");
      };

      if (!video.dataset.listenersAttached) {
        video.dataset.listenersAttached = "true";

        // Revelar video únicamente cuando empiece a reproducirse efectivamente
        video.addEventListener("playing", revealVideo);
        video.addEventListener("timeupdate", () => {
          if (
            video.currentTime > 0.05 &&
            !video.classList.contains("opacity-100") &&
            isPlaying
          ) {
            revealVideo();
          }
        });

        // Al terminar el video, ocultarlo suavemente y volver a mostrar la imagen
        video.addEventListener("ended", () => {
          hideVideo();
          isPlaying = false;
          setTimeout(() => {
            if (!isPlaying) {
              video.currentTime = 0;
            }
          }, 700);
        });

        // Permitir clic sobre la imagen para volver a reproducir
        mediaContainer?.addEventListener("click", () => {
          if (!isPlaying) {
            playVideo();
          }
        });

        // Observar cuando se selecciona otro profesor
        const observer = new MutationObserver((mutations) => {
          mutations.forEach((mutation) => {
            if (
              mutation.type === "attributes" &&
              mutation.attributeName === "class"
            ) {
              if (descItem.classList.contains("block")) {
                playVideo();
              } else {
                stopAndReset();
              }
            }
          });
        });

        observer.observe(descItem, { attributes: true });
      }

      // Si el profesor ya está activo al cargar la página
      if (descItem.classList.contains("block")) {
        playVideo();
      }
    });
  }

  document.addEventListener("astro:page-load", initCoachVideos);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCoachVideos);
  } else {
    initCoachVideos();
  }
</script>
