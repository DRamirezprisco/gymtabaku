---
import Titulo from "@/components/global/Titulo.astro";

interface Props {
  isActive?: boolean;
  index?: number;
  tittle?: string;
  subTittle?: string;
  description?: string;
  description2?: string;
  description3?: string;
  img?: string;
  wallpaperSrc?: string;
}

const {
  isActive = false,
  index = 0,
  tittle,
  subTittle,
  description,
  description2,
  description3,
  img,
} = Astro.props;
---

<div
  data-coach-description={index}
  class:list={[
    "coach-description-item w-full max-w-6xl 2xl:max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 md:py-16 lg:py-20 z-10 transition-opacity duration-300",
    isActive ? "block" : "hidden",
  ]}
>
  <div
    class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-10 lg:gap-12 items-center"
  >
    <!-- Imagen del Profesor: Adaptable en móvil/tablet y columna elegante en desktop -->
    <div
      class="absolute top-20 md:top-15 lg:top-1/2 lg:-translate-y-1/2 -left-10 lg:left-0 w-full"
    >
      <div
        class="relative w-full lg:w-110 xl:w-140 2xl:w-170 rounded-br-2xl rounded-tr-2xl overflow-hidden shadow-2xl"
        data-reveal="fade-right"
        data-reveal-delay="200"
      >
        <img
          src={img}
          alt={tittle}
          class="w-full h-87 md:h-100 lg:h-120 object-cover object-center"
          loading="lazy"
        />
      </div>
    </div>

    <div
      class="lg:col-span-5 relative w-full max-w-md sm:max-w-lg lg:max-w-none mx-auto h-100"
    >
    </div>

    <!-- Información y Trayectoria del Profesor -->
    <div
      class="lg:col-span-7 flex flex-col justify-center items-start lg:pl-4 gap-2 sm:gap-3 z-10"
      data-reveal="fade-left"
      data-reveal-delay="400"
    >
      <div class="mb-1">
        <Titulo title={tittle || ""} isdark={true} />
      </div>

      <h2
        class="w-full text-xl sm:text-2xl md:text-3xl font-black text-gym-dark-text-primary tracking-tight leading-tight"
      >
        {subTittle}
      </h2>

      <p
        class="text-sm sm:text-base lg:text-lg text-gym-dark-text-secondary leading-relaxed pt-2"
      >
        {description}
      </p>

      <p
        class="text-sm sm:text-base lg:text-lg text-gym-dark-text-secondary leading-relaxed"
      >
        {description2}
      </p>

      <!-- Cita / Compromiso personal del profesor -->
      <div class="w-full mt-4 sm:mt-6" data-reveal="fade-up" data-reveal-delay="600">
        <div
          class="w-full sm:w-11/12 md:w-5/6 p-4 sm:p-5 rounded-2xl bg-gym-bg-card/40 border border-gym-yellow/30 shadow-lg backdrop-blur-xs transition-all duration-300 hover:border-gym-yellow hover:shadow-[0_0_30px_rgba(255,204,0,0.2)]"
        >
          <p
            class="text-sm sm:text-base lg:text-lg italic font-semibold text-secondary-50 text-center leading-relaxed"
          >
            {description3}
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
