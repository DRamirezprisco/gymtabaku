---
import Titulo from "@/components/global/Titulo.astro";

interface Props {
    isActive?: boolean;
    tittle?: string;
    subTittle?: string;
    description?: string;
    description2?: string;
    description3?: string;
    img?: string;
    wallpaperSrc?: string;
}

const {
    isActive,
    tittle,
    subTittle,
    description,
    description2,
    description3,
    img,
    wallpaperSrc,
} = Astro.props;
---

<div
    class={`w-full max-w-350 mx-auto px-4 sm:px-6 lg:px-8 z-10 ${isActive ? "block" : "hidden"}`}
>
    <div
        class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center h-200"
    >
        <div
            class="absolute left-0 w-200 h-100 sm:h-125 lg:h-140 rounded-br-3xl rounded-tr-3xl overflow-hidden shadow-2xl"
        >
            <img
                src={img}
                alt={tittle}
                class="w-full h-full object-cover object-center"
            />
        </div>

        <div class="col-span-5"></div>
        <div
            class="lg:col-span-6 flex flex-col justify-center items-start lg:pl-6 gap-1 z-10"
        >
            <h2
                class="font-serif text-base sm:text-lg md:text-xl lg:text-3xl text-gym-yellow"
            >
                <Titulo title={tittle} isdark={true} />
            </h2>
            <h1
                class="mt-2 mb-6 sm:text-4xl md:text-2xl xl:text-3xl text-gym-dark-text-primary"
            >
                {subTittle}
            </h1>

            <p
                class="text-center md:text-base xl:text-lg text-gym-dark-text-secondary"
            >
                {description}
            </p>
            <p
                class="text-center md:text-base xl:text-lg text-gym-dark-text-secondary"
            >
                {description2}
            </p>
            <div
                class="mt-10 inline-flex- items-center gap-3 px-8 py-4 rounded-md bg-gym-bg-card/50 border border-gym-yellow/20"
            >
                <p
                    class="md:text-base xl:text-lg font-bold text-gym-dark-text-secondary justify-center items-center"
                >
                    {description3}
                </p>
            </div>
        </div>
    </div>
</div>
