---
interface GalleryCoaches {
  img?: string;
  alt?: string;
  title?: string;
}

interface Props {
  isActive?: boolean;
  gallery?: GalleryCoaches[];
  index?: number;
}

const { isActive = false, gallery = [], index = 0 } = Astro.props;

const originalGallery = gallery || [];
// Duplicamos el conjunto de fotos 3 veces (para llegar a 12 slides)
// de modo que el bucle continuo ('loop: true') de Swiper con 'slidesPerView: auto'
// tenga suficientes diapositivas en el DOM y nunca se bloquee ni muestre huecos.
const repeatedGallery =
  originalGallery.length > 0 && originalGallery.length < 12
    ? [...originalGallery, ...originalGallery, ...originalGallery]
    : originalGallery;
---

<div
  data-coach-gallery={index}
  class:list={[
    "coach-gallery-item w-full transition-opacity duration-300",
    isActive ? "block" : "hidden",
  ]}
>
  <div class="py-4 sm:py-6 relative">
    <div
      class="w-full max-w-6xl 2xl:max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"
      data-reveal="fade-up"
      data-reveal-delay="200"
    >
      <div class="swiper coach-gallery-swiper overflow-hidden px-1">
        <div class="swiper-wrapper pt-6 sm:pt-8 pb-8 sm:pb-24 lg:pb-28">
          {
            repeatedGallery?.map((item, i) => {
              const isWide = i % 2 === 0;
              const step = i % 3;
              const photoIndex =
                originalGallery.length > 0 ? i % originalGallery.length : i;
              return (
                <div
                  class="swiper-slide !w-auto shrink-0 py-2"
                  data-photo-index={photoIndex}
                >
                  <!-- Tarjeta de la Galería con traslación escalonada arriba/abajo (Efecto de onda) -->
                  <div
                    data-offset-step={step}
                    class:list={[
                      "relative group cursor-pointer select-none transition-transform duration-300",
                      "data-[offset-step='0']:-translate-y-3 sm:data-[offset-step='0']:-translate-y-5 lg:data-[offset-step='0']:-translate-y-7",
                      "data-[offset-step='1']:translate-y-6 sm:data-[offset-step='1']:translate-y-10 lg:data-[offset-step='1']:translate-y-[65px]",
                      "data-[offset-step='2']:translate-y-2 sm:data-[offset-step='2']:translate-y-4 lg:data-[offset-step='2']:translate-y-[28px]",
                    ]}
                  >
                    <!-- Contenedor de la Imagen con overflow-hidden para zoom suave sin recortar texto exterior -->
                    <div
                      class:list={[
                        "overflow-hidden rounded-xl sm:rounded-2xl shadow-2xl border border-white/10 bg-secondary-900 transition-all duration-300",
                        isWide
                          ? "w-[72vw] max-w-[320px] sm:max-w-none sm:w-[320px] md:w-[360px] lg:w-[400px] xl:w-[430px]"
                          : "w-[54vw] max-w-[240px] sm:max-w-none sm:w-[210px] md:w-[240px] lg:w-[260px] xl:w-[280px]",
                        "h-68 sm:h-76 md:h-84 lg:h-92",
                      ]}
                    >
                      <img
                        src={item.img}
                        alt={item.alt || `Galería ${photoIndex + 1}`}
                        class="w-full h-full object-cover object-center group-hover:scale-105 group-hover:rotate-1 transition-transform duration-500"
                        loading="lazy"
                      />
                      <!-- Gradiente de Contraste para el Texto -->
                      <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent pointer-events-none" />
                    </div>

                    <!-- Texto con título y barra amarilla SOBRESALIENDO a la izquierda -->
                    <div class="absolute bottom-4 sm:bottom-6 lg:bottom-8 -left-3 sm:-left-5 lg:-left-7 flex flex-col justify-end py-1 z-20 pointer-events-none max-w-[120%] sm:max-w-[125%]">
                      <h3 class="font-serif text-lg sm:text-2xl lg:text-3xl font-bold leading-tight mb-2 text-white drop-shadow-[0_4px_8px_rgba(0,0,0,0.95)] [-webkit-text-stroke:1px_rgba(0,0,0,0.7)] group-hover:text-gym-yellow transition-colors">
                        {item.title || item.alt || "Fitness & Entrenamiento"}
                      </h3>
                      <!-- Línea decorativa AMARILLA que también sobresale y se expande en hover -->
                      <div class="w-14 sm:w-20 group-hover:w-24 sm:group-hover:w-36 transition-all duration-300 h-1 sm:h-1.5 bg-gym-yellow shadow-[0_2px_10px_rgba(255,222,77,0.5)] rounded-full" />
                    </div>
                  </div>
                </div>
              );
            })
          }
        </div>

        <!-- Controles Inferiores Centrados (Flechas + Paginación 01 02 03 04) -->
        <div
          class="flex items-center justify-center gap-4 sm:gap-6 mt-2 sm:mt-4 mb-2 relative z-20 mx-auto max-w-xs"
        >
          <!-- Botón Prev -->
          <button
            type="button"
            aria-label="Foto anterior"
            class="gallery-prev size-10 sm:size-11 rounded-xl bg-primary-500 hover:bg-primary-400 text-secondary-950 flex items-center justify-center font-bold shadow-lg transition-all duration-200 cursor-pointer hover:scale-105 active:scale-95 shrink-0 border border-primary-400"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-5 sm:size-6 rotate-180"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M9 6l6 6l-6 6"></path>
            </svg>
          </button>

          <!-- Paginación Números (01, 02, 03, 04) -->
          <div
            class="gallery-custom-pagination flex items-center justify-center gap-3 text-white font-bold text-sm tracking-widest select-none"
            data-total-photos={originalGallery.length}
          >
            {
              originalGallery.map((_, pIndex) => (
                <button
                  type="button"
                  data-photo-bullet={pIndex}
                  class:list={[
                    "gallery-bullet cursor-pointer bg-transparent text-sm font-bold transition-all px-1 py-0.5 select-none",
                    pIndex === 0
                      ? "text-yellow-400 text-base opacity-100 font-extrabold"
                      : "text-white opacity-60 hover:opacity-100",
                  ]}
                >
                  {(pIndex + 1).toString().padStart(2, "0")}
                </button>
              ))
            }
          </div>

          <!-- Botón Next -->
          <button
            type="button"
            aria-label="Foto siguiente"
            class="gallery-next size-10 sm:size-11 rounded-xl bg-primary-500 hover:bg-primary-400 text-secondary-950 flex items-center justify-center font-bold shadow-lg transition-all duration-200 cursor-pointer hover:scale-105 active:scale-95 shrink-0 border border-primary-400"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-5 sm:size-6"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M9 6l6 6l-6 6"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import Swiper from "swiper";
  import { Navigation, Autoplay } from "swiper/modules";

  const swiperInstances: Swiper[] = [];

  function updateGalleryBullets(swiper: Swiper, container: HTMLElement) {
    const activeSlide = swiper.slides[swiper.activeIndex];
    if (!activeSlide) return;
    const photoIdxStr = activeSlide.getAttribute("data-photo-index");
    if (photoIdxStr === null) return;
    const currentPhotoIdx = parseInt(photoIdxStr, 10);

    const bullets =
      container.querySelectorAll<HTMLElement>("[data-photo-bullet]");
    bullets.forEach((bullet) => {
      const bIdx = parseInt(
        bullet.getAttribute("data-photo-bullet") || "-1",
        10,
      );
      if (bIdx === currentPhotoIdx) {
        bullet.classList.add(
          "text-yellow-400",
          "text-base",
          "opacity-100",
          "font-extrabold",
        );
        bullet.classList.remove("text-white", "opacity-60");
      } else {
        bullet.classList.remove(
          "text-yellow-400",
          "text-base",
          "opacity-100",
          "font-extrabold",
        );
        bullet.classList.add("text-white", "opacity-60");
      }
    });
  }

  const initGalleries = () => {
    swiperInstances.forEach((s) => {
      try {
        s.destroy(true, true);
      } catch {}
    });
    swiperInstances.length = 0;

    document
      .querySelectorAll<HTMLElement>(".coach-gallery-swiper")
      .forEach((container) => {
        const swiper = new Swiper(container, {
          modules: [Navigation, Autoplay],
          slidesPerView: "auto",
          spaceBetween: 24,
          loop: true,
          grabCursor: true,
          observer: true,
          observeParents: true,
          navigation: {
            nextEl: container.querySelector<HTMLElement>(".gallery-next"),
            prevEl: container.querySelector<HTMLElement>(".gallery-prev"),
          },
          autoplay: {
            delay: 4500,
            disableOnInteraction: true,
            pauseOnMouseEnter: true,
          },
          breakpoints: {
            640: {
              spaceBetween: 36,
            },
            1024: {
              spaceBetween: 48,
            },
          },
          on: {
            init(s) {
              updateGalleryBullets(s, container);
            },
            slideChange(s) {
              updateGalleryBullets(s, container);
            },
          },
        });

        // Event listener para los botones de paginación de fotos (01, 02, 03, 04)
        const bullets =
          container.querySelectorAll<HTMLElement>("[data-photo-bullet]");
        bullets.forEach((bullet) => {
          bullet.addEventListener("click", () => {
            const targetIdx = parseInt(
              bullet.getAttribute("data-photo-bullet") || "0",
              10,
            );
            // Buscar la diapositiva más cercana con data-photo-index coincidente
            let closestSlideIndex = -1;
            let minDistance = Infinity;
            swiper.slides.forEach((slide, idx) => {
              const pIdx = parseInt(
                slide.getAttribute("data-photo-index") || "-1",
                10,
              );
              if (pIdx === targetIdx) {
                const distance = Math.abs(idx - swiper.activeIndex);
                if (distance < minDistance) {
                  minDistance = distance;
                  closestSlideIndex = idx;
                }
              }
            });
            if (closestSlideIndex !== -1) {
              swiper.slideTo(closestSlideIndex);
            }
          });
        });

        swiperInstances.push(swiper);
      });
  };

  document.addEventListener("astro:page-load", initGalleries);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initGalleries);
  } else {
    initGalleries();
  }
</script>

<style is:global>
  .gallery-bullet {
    width: auto !important;
    height: auto !important;
    background: transparent !important;
    border: none;
    outline: none;
  }
  .gallery-prev.swiper-button-lock,
  .gallery-next.swiper-button-lock {
    display: none !important;
  }
</style>