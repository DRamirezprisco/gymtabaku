---
interface GalleryCoaches {
  img?: string;
  alt?: string;
  title?: string;
}

interface Props {
  isActive?: boolean;
  gallery?: GalleryCoaches[];
  index?: number;
}

const { isActive = false, gallery = [], index = 0 } = Astro.props;
---

<div
  data-coach-gallery={index}
  class:list={[
    "coach-gallery-item w-full transition-opacity duration-300",
    isActive ? "block" : "hidden",
  ]}
>
  <div class="py-4 sm:py-6 relative">
    <div
      class="w-full max-w-6xl 2xl:max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"
      data-reveal="fade-up"
      data-reveal-delay="200"
    >
      <div class="swiper coach-gallery-swiper overflow-hidden">
        <div class="swiper-wrapper pt-4 sm:pt-6 pb-6 sm:pb-24 lg:pb-28">
          {
            gallery?.map((item, i) => {
              const step = i % 3;
              return (
                <div class="swiper-slide flex justify-center py-2">
                  <!-- Tarjeta de la Galería con traslación escalonada arriba/abajo (Efecto de onda) -->
                  <div
                    data-offset-step={step}
                    class:list={[
                      "relative group cursor-pointer w-full sm:max-w-md overflow-hidden rounded-xl sm:rounded-2xl shadow-xl border border-white/10 bg-secondary-900 select-none transition-all duration-300",
                      "data-[offset-step='0']:-translate-y-5",
                      "data-[offset-step='1']:translate-y-7 sm:data-[offset-step='1']:translate-y-12 lg:data-[offset-step='1']:translate-y-[70px]",
                      "data-[offset-step='2']:translate-y-3.5 sm:data-[offset-step='2']:translate-y-6 lg:data-[offset-step='2']:translate-y-[35px]",
                    ]}
                  >
                    <img
                      src={item.img}
                      alt={item.alt || `Galería ${i + 1}`}
                      class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                    />
                    <!-- Gradiente de Contraste para el Texto -->
                    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent pointer-events-none" />

                    <!-- Texto con título y barra amarilla -->
                    <div class="absolute bottom-3 left-3 sm:bottom-4 sm:left-4 right-3 sm:right-4 flex flex-col justify-end py-1 z-10 pointer-events-none">
                      <h3 class="font-serif text-base sm:text-lg md:text-xl font-bold leading-snug mb-1 text-white drop-shadow-md group-hover:text-gym-yellow transition-colors line-clamp-2">
                        {item.title || item.alt || "Fitness & Entrenamiento"}
                      </h3>
                      <!-- Línea decorativa AMARILLA -->
                      <div class="w-12 sm:w-16 group-hover:w-24 sm:group-hover:w-32 transition-all duration-300 h-1 bg-gym-yellow rounded-full" />
                    </div>
                  </div>
                </div>
              );
            })
          }
        </div>

        <!-- Controles Inferiores Centrados (Flechas + Paginación 01 02 03) -->
        <div class="flex items-center justify-center gap-4 sm:gap-6 mt-2 sm:mt-4 mb-2 relative z-20 mx-auto max-w-xs">
          <!-- Botón Prev -->
          <button
            type="button"
            aria-label="Foto anterior"
            class="gallery-prev size-10 sm:size-11 rounded-xl bg-primary-500 hover:bg-primary-400 text-secondary-950 flex items-center justify-center font-bold shadow-lg transition-all duration-200 cursor-pointer hover:scale-105 active:scale-95 shrink-0 border border-primary-400"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-5 sm:size-6 rotate-180"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M9 6l6 6l-6 6" />
            </svg>
          </button>

          <!-- Paginación Números (01, 02, 03) -->
          <div class="gallery-pagination flex items-center justify-center gap-3 text-white font-bold text-sm tracking-widest"></div>

          <!-- Botón Next -->
          <button
            type="button"
            aria-label="Foto siguiente"
            class="gallery-next size-10 sm:size-11 rounded-xl bg-primary-500 hover:bg-primary-400 text-secondary-950 flex items-center justify-center font-bold shadow-lg transition-all duration-200 cursor-pointer hover:scale-105 active:scale-95 shrink-0 border border-primary-400"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-5 sm:size-6"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M9 6l6 6l-6 6" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import Swiper from "swiper";
  import { Navigation, Pagination, Autoplay } from "swiper/modules";

  const swiperInstances: Swiper[] = [];

  const initGalleries = () => {
    swiperInstances.forEach((s) => {
      try {
        s.destroy(true, true);
      } catch {}
    });
    swiperInstances.length = 0;

    document
      .querySelectorAll<HTMLElement>(".coach-gallery-swiper")
      .forEach((container) => {
        const swiper = new Swiper(container, {
          modules: [Navigation, Pagination, Autoplay],
          slidesPerView: 1,
          spaceBetween: 18,
          loop: true,
          grabCursor: true,
          observer: true,
          observeParents: true,
          navigation: {
            nextEl: container.querySelector<HTMLElement>(".gallery-next"),
            prevEl: container.querySelector<HTMLElement>(".gallery-prev"),
          },
          pagination: {
            el: container.querySelector<HTMLElement>(".gallery-pagination"),
            clickable: true,
            renderBullet: function (index, className) {
              const formattedNumber = (index + 1).toString().padStart(2, "0");
              return `<span class="${className} cursor-pointer [&.swiper-pagination-bullet-active]:bg-transparent! [&.swiper-pagination-bullet-active]:text-yellow-400 [&.swiper-pagination-bullet-active]:text-base font-bold transition-all select-none">${formattedNumber}</span>`;
            },
          },
          autoplay: {
            delay: 4500,
            disableOnInteraction: true,
            pauseOnMouseEnter: true,
          },
          breakpoints: {
            640: { slidesPerView: 2, spaceBetween: 20 },
            1024: { slidesPerView: 3, spaceBetween: 24 },
          },
        });
        swiperInstances.push(swiper);
      });
  };

  document.addEventListener("astro:page-load", initGalleries);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initGalleries);
  } else {
    initGalleries();
  }
</script>

<style is:global>
  .coach-gallery-swiper .swiper-pagination-bullet {
    width: auto !important;
    height: auto !important;
    background: transparent !important;
    opacity: 0.6 !important;
    font-size: 0.95rem;
    padding: 0 4px;
    margin: 0 !important;
    color: #ffffff;
  }
  .coach-gallery-swiper .swiper-pagination-bullet-active {
    opacity: 1 !important;
    color: #eab308 !important;
    font-size: 1.15rem !important;
  }
</style>