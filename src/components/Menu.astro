---
import Button from "@/components/global/Button.astro";
import { isMenuActive } from "@/utils/menu";
import { NAV_ITEMS } from "@/components/constants/navigation";

const pathname = Astro.url.pathname;

const menu = NAV_ITEMS.map((item) => ({
  ...item,
  isActive: isMenuActive(pathname, item.key),
}));
---

<nav
  class="max-w-6xl 2xl:max-w-7xl w-[calc(100%-1.5rem)] sm:w-[calc(100%-2.5rem)] lg:w-full mx-auto bg-secondary-950/95 lg:bg-secondary-950 bg-repeat bg-contain flex items-center justify-between relative z-30 mt-3 sm:mt-5 lg:mt-6 px-3.5 sm:px-6 lg:px-8 py-2 sm:py-2.5 lg:py-0 rounded-2xl lg:rounded-none border border-secondary-800/80 lg:border-none shadow-xl lg:shadow-none lg:after:-skew-x-12 lg:after:w-[105%] lg:after:h-[101%] lg:after:content-[''] lg:after:absolute lg:after:top-0 lg:after:left-1/2 lg:after:-translate-x-1/2 lg:after:-z-10 lg:after:bg-secondary-950 lg:after:bg-[url('/img/bg/bgmenu.webp')] lg:after:bg-contain lg:after:bg-repeat after:hidden lg:after:block"
>
  <!-- Logo y Marca -->
  <div class="flex items-center py-2 sm:py-2.5 lg:py-4 gap-3 sm:gap-6">
    <a
      href="/"
      class="shrink-0 transition delay-150 duration-300 ease-in-out hover:scale-110 size-12 sm:size-14 lg:size-16 flex items-center justify-center"
      aria-label="Gym Tabaku - Inicio"
    >
      <img
        src="/img/logo.webp"
        alt="logo gym tabaku"
        class="w-full h-full object-contain"
      />
    </a>
  </div>

  <!-- Navegación Desktop (Visible a partir del breakpoint lg: 1024px) -->
  <div class="hidden lg:flex items-center justify-center flex-1 mx-2 xl:mx-4">
    <ul class="flex items-center gap-1 xl:gap-3 2xl:gap-5">
      {
        menu.map((item) => (
          <li>
            <a
              href={item.url}
              class={`inline-block px-2.5 xl:px-3 py-1.5 text-sm xl:text-base 2xl:text-lg capitalize font-bold rounded-lg transition-all duration-200 ${
                item.isActive
                  ? "text-primary-400 font-extrabold"
                  : "text-secondary-100 hover:text-primary-400 hover:scale-105"
              } cursor-pointer`}
            >
              {item.name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Botón CTA en barra y botón toggle de menú móvil -->
  <div class="flex items-center justify-end gap-2 sm:gap-4 shrink-0">
    <div class="hidden sm:block">
      <Button text="Inscribete" url="/" />
    </div>

    <!-- Botón Hamburguesa Móvil (Visible por debajo de lg: 1024px) -->
    <button
      id="menuNavMobileBut"
      type="button"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobileNavMenu"
      class="lg:hidden p-2 rounded-xl text-secondary-100 hover:text-primary-400 hover:bg-secondary-800/80 active:scale-95 focus:outline-none focus:ring-2 focus:ring-primary-500/50 transition-all duration-200 cursor-pointer"
    >
      <!-- Icono Hamburguesa (Cerrado) -->
      <svg
        id="hamburgerIcon"
        class="w-7 h-7 block"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <!-- Icono Cerrar (Abierto) -->
      <svg
        id="closeIcon"
        class="w-7 h-7 hidden"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>
</nav>

<!-- Backdrop del Menú Móvil -->
<div
  id="mobileMenuBackdrop"
  class="fixed inset-0 bg-black/80 backdrop-blur-xs z-[990] hidden opacity-0 transition-opacity duration-300 lg:hidden"
  aria-hidden="true"
>
</div>

<!-- Drawer Lateral del Menú Móvil -->
<aside
  id="mobileNavMenu"
  class="fixed top-0 right-0 z-[1000] h-full w-[85%] max-w-sm bg-secondary-950 bg-[url('/img/bg/bgoscuro.webp')] bg-cover bg-repeat shadow-2xl border-l border-secondary-800 flex flex-col justify-between transform translate-x-full transition-transform duration-300 ease-in-out lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Menú principal de navegación"
>
  <!-- Encabezado del Drawer -->
  <div
    class="flex items-center justify-between p-5 border-b border-secondary-800/80 bg-secondary-950/90"
  >
    <a class="flex items-center gap-3" href="/">
      <img
        src="/img/logo.webp"
        alt="logo gym tabaku"
        class="size-10 object-contain"
      />
      <span
        class="font-serif font-bold text-xl uppercase tracking-wider text-primary-500"
      >
        GYM TABAKU
      </span>
    </a>

    <button
      id="mobileMenuCloseBut"
      type="button"
      aria-label="Cerrar menú de navegación"
      class="p-2 rounded-lg text-secondary-300 hover:text-primary-400 hover:bg-secondary-800/80 active:scale-95 transition-all duration-200 cursor-pointer"
    >
      <svg
        class="w-6 h-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Enlaces de Navegación Móvil -->
  <div class="flex-1 overflow-y-auto py-6 px-4">
    <ul class="space-y-2">
      {
        menu.map((item) => (
          <li>
            <a
              href={item.url}
              class={`flex items-center px-4 py-3 text-lg font-bold rounded-xl transition-all duration-200 ${
                item.isActive
                  ? "text-secondary-950 bg-primary-500 border-l-4 pl-5 shadow-inner"
                  : "text-secondary-100 hover:text-primary-400 hover:bg-secondary-900/50"
              }`}
            >
              {item.name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Pie del Drawer con CTA Button y Slogan -->
  <div
    class="p-5 border-t border-secondary-800/80 bg-secondary-950/95 space-y-4"
  >
    <div class="w-full flex justify-center">
      <Button text="Inscribete" url="/" class="w-full" />
    </div>
    <p class="text-xs text-center font-medium text-secondary-400">
      ¡Entrena con fuerza. Crece en familia!
    </p>
  </div>
</aside>

<script>
  function initMobileMenu() {
    const toggleBtn = document.getElementById("menuNavMobileBut");
    const closeBtn = document.getElementById("mobileMenuCloseBut");
    const drawer = document.getElementById("mobileNavMenu");
    const backdrop = document.getElementById("mobileMenuBackdrop");
    const hamburgerIcon = document.getElementById("hamburgerIcon");
    const closeIcon = document.getElementById("closeIcon");
    const navLinks = drawer?.querySelectorAll("a");

    if (!toggleBtn || !drawer || !backdrop) return;

    // Aseguramos que el backdrop y el drawer lateral del menú móvil
    // se sitúen en el nivel raíz del body (fuera de cualquier stacking context
    // con z-index relativo de los encabezados de las páginas)
    if (backdrop.parentElement !== document.body) {
      document.body.appendChild(backdrop);
    }
    if (drawer.parentElement !== document.body) {
      document.body.appendChild(drawer);
    }

    if (toggleBtn.dataset.menuInitialized === "true") return;
    toggleBtn.dataset.menuInitialized = "true";

    function updateIcons(isOpen: boolean) {
      if (!hamburgerIcon || !closeIcon) return;
      if (isOpen) {
        hamburgerIcon.classList.remove("block");
        hamburgerIcon.classList.add("hidden");
        closeIcon.classList.remove("hidden");
        closeIcon.classList.add("block");
      } else {
        closeIcon.classList.remove("block");
        closeIcon.classList.add("hidden");
        hamburgerIcon.classList.remove("hidden");
        hamburgerIcon.classList.add("block");
      }
    }

    function openMenu() {
      drawer.classList.remove("translate-x-full");
      backdrop.classList.remove("hidden");
      requestAnimationFrame(() => {
        backdrop.classList.remove("opacity-0");
        backdrop.classList.add("opacity-100");
      });
      toggleBtn.setAttribute("aria-expanded", "true");
      updateIcons(true);
      document.body.style.overflow = "hidden";
    }

    function closeMenu() {
      drawer.classList.add("translate-x-full");
      backdrop.classList.remove("opacity-100");
      backdrop.classList.add("opacity-0");
      toggleBtn.setAttribute("aria-expanded", "false");
      updateIcons(false);
      document.body.style.overflow = "";
      setTimeout(() => {
        if (drawer.classList.contains("translate-x-full")) {
          backdrop.classList.add("hidden");
        }
      }, 300);
    }

    toggleBtn.addEventListener("click", () => {
      const isExpanded = toggleBtn.getAttribute("aria-expanded") === "true";
      if (isExpanded) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    closeBtn?.addEventListener("click", closeMenu);
    backdrop.addEventListener("click", closeMenu);

    navLinks?.forEach((link) => {
      link.addEventListener("click", () => {
        closeMenu();
      });
    });

    document.addEventListener("keydown", (e) => {
      if (
        e.key === "Escape" &&
        toggleBtn.getAttribute("aria-expanded") === "true"
      ) {
        closeMenu();
      }
    });

    window.addEventListener("resize", () => {
      if (
        window.innerWidth >= 1024 &&
        toggleBtn.getAttribute("aria-expanded") === "true"
      ) {
        closeMenu();
      }
    });
  }

  // Inicializar en carga tradicional y en transiciones de página Astro
  document.addEventListener("DOMContentLoaded", initMobileMenu);
  document.addEventListener("astro:page-load", initMobileMenu);
</script>
