---
import Titulo from "./Titulo.astro";
const prices = [
  {
    price: 70,
    duration: "1 Mes",
  },
  {
    price: 120,
    duration: "2 Meses",
  },
  {
    price: 200,
    duration: "4 Meses",
  },
  {
    price: 290,
    duration: "6 Meses",
  },
  {
    price: 490,
    duration: "12 Meses",
  },
];
---

<section
  class="relative bg-gym-bg bg-[url('/img/bg/bgclaroflip.webp')] bg-cover w-full h-200 overflow-hidden"
>
  <div class="absolute -bottom-50 left-0 w-full">
    <img
      src="/img/fondoyellow.webp"
      alt=""
      class="w-full rotate-y-180 object-cover"
    />
  </div>

  <div
    class="max-w-md sm:max-w-lg md:max-w-4xl lg:max-w-6xl xl:max-w-7xl mx-auto w-full z-10"
  >
    <div
      class="bg-secondary-800/10 rounded-xl animate-fade-in-up flex flex-col justify-center items-center gap-3 lg:mx-3 z-20 px-5 py-7 mt-14"
    >
      <Titulo title="Precios" />

      <h1 class="my-2 text-4xl sm:text-5xl md:text-3xl xl:text-4xl">
        Elige el precio que mejor se adapte a ti
      </h1>

      <p
        class="md:text-base xl:text-lg text-gym-text-secondary w-9/12 text-center"
      >
        Da el primer paso hacia una vida más activa y saludable con precios
        accesibles diseñados para ayudarte a alcanzar tus objetivos sin
        complicaciones.
      </p>
    </div>

    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 mt-20 z-10"
    >
      {
        prices.map((price) => {
          return (
            <div class="bg-gym-dark-bg-card-hover rounded-md p-6 w-60 h-40 flex flex-col items-center justify-center gap-4 overflow-hidden relative z-0">
              <img
                src="/img/bg/bgclaro.webp"
                alt=""
                class="absolute top-0 right-0 h-30 -z-10"
              />
              <h2 class="bg-gym-yellow p-4 rounded-md text-2xl font-bold absolute top-4 left-4">
                ${price.price} <span class="text-xs -ml-0.5">.000</span>
              </h2>
              <p class="text-gym-dark-text-primary text-bold text-2xl absolute bottom-8">
                {price.duration}
              </p>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
