---
interface Props {
  title: string;
  isdark?: boolean;
  large?: boolean;
}

const { title, isdark, large } = Astro.props;
const textColor = isdark ? "text-gym-yellow" : "text-gym-text-secondary";
const lineWidth = large
  ? "w-8 sm:w-12 md:w-20 lg:w-28 xl:w-36"
  : "w-6 sm:w-10 md:w-16 lg:w-24 xl:w-32";
---

<div
  class="flex items-center justify-center gap-2 sm:gap-3 lg:gap-4 max-w-full"
>
  <div class={`bg-gym-yellow h-1 rounded-full shrink ${lineWidth}`}></div>
  <h3
    class={`uppercase font-serif text-lg sm:text-xl md:text-2xl lg:text-3xl whitespace-nowrap shrink-0 ${textColor}`}
  >
    {title}
  </h3>
  <div class={`bg-gym-yellow h-1 rounded-full shrink ${lineWidth}`}></div>
</div>
