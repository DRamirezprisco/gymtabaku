---
interface Props {
  text: string;
  url?: string;
  white?: boolean;
  black?: boolean;
  class?: string;
  target?: string;
  rel?: string;
  ariaLabel?: string;
}

const {
  text,
  url = "#",
  white,
  black,
  class: className = "",
  target,
  rel,
  ariaLabel,
} = Astro.props;

const isExternal = url.startsWith("http://") || url.startsWith("https://") || url.startsWith("//");
const finalTarget = target || (isExternal ? "_blank" : undefined);
const finalRel = rel || (isExternal ? "noopener noreferrer" : undefined);

const buttoncolor = white
  ? "bg-white hover:bg-white border-white hover:border-white before:border-white hover:before:border-white text-secondary-950"
  : black
    ? "bg-secondary-500 hover:bg-secondary-500 border-secondary-500 hover:border-secondary-500 before:border-secondary-500 hover:before:border-secondary-500 text-white"
    : "bg-primary-500 hover:bg-primary-400 border-primary-500 hover:border-primary-400 before:border-primary-500 hover:before:border-primary-400 text-secondary-950";
---

<a
  class={`text-center
    duration-250
    ease-in-out
    disabled:hover:none
    disabled:pointer-events-none relative
    leading-none
    font-serif
    tracking-wider
    text-sm sm:text-base lg:text-base xl:text-lg 2xl:text-xl
    px-3.5 sm:px-4 lg:px-5 xl:px-6 2xl:px-7
    py-1.5 sm:py-2 lg:py-2 xl:py-2.5 2xl:py-3
    min-w-28 sm:min-w-32 lg:min-w-36 xl:min-w-44 2xl:min-w-52
    border-2 xl:border-3
    ${buttoncolor}
    ease-[cubic-bezier(0.33, 1, 0.68, 1)]
    before:content-['']
    before:w-full before:h-full before:absolute before:top-0 before:left-0
    before:border-2 xl:before:border-3
    before:translate-y-1.5 before:-translate-x-1.5
    lg:before:translate-y-2 lg:before:-translate-x-2
    xl:before:translate-y-2.5 xl:before:-translate-x-2.5
    2xl:before:translate-y-3 2xl:before:-translate-x-3
    before:transition-transform before:duration-200 before:ease-[cubic-bezier(0.33, 1, 0.68, 1)]
    hover:before:translate-x-0 hover:before:translate-y-0
    active:before:translate-x-0 active:before:translate-y-0
    inline-flex items-center justify-center cursor-pointer ${className}`}
  href={url}
  target={finalTarget}
  rel={finalRel}
  aria-label={ariaLabel}
>{text}</a>
