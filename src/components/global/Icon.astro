---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div
  class={`relative size-12 sm:size-13 shrink-0 inline-flex items-center justify-center bg-primary-500 hover:bg-primary-400 text-secondary-950 border-2 border-primary-500 hover:border-primary-400 cursor-pointer transition-all duration-200
    before:content-[''] before:w-full before:h-full before:absolute before:top-0 before:left-0 before:border-2 before:border-primary-500 hover:before:border-primary-400 before:translate-y-1.5 before:-translate-x-1.5
    before:transition-transform before:duration-200 before:-z-10 hover:before:translate-x-0 hover:before:translate-y-0 active:scale-95 ${className}`}
>
  <slot />
</div>
