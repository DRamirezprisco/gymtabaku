---
interface Props {
    text: string;
    price?: string;
    isActive?: boolean;
    variant?: "dark" | "primary";
    layout?: "vertical" | "horizontal" | "responsive";
    class?: string;
}

const {
    text,
    price,
    isActive = false,
    variant = "dark",
    layout = "responsive",
    class: className = "",
} = Astro.props;

// Estilos dinámicos según el variant
const isPrimary = variant === "primary";
---

<button
    class:list={[
        // Flexbox en columna para centrar vertical/horizontalmente
        "group flex flex-col justify-center items-center text-center leading-tight font-serif tracking-0.125 relative transition-all duration-300 z-10 cursor-pointer",

        // Dimensiones según layout
        layout === "responsive"
            ? "w-64 sm:w-full sm:max-w-[210px] md:max-w-[230px] lg:w-70 min-h-16 sm:min-h-14 lg:min-h-18 py-2 sm:py-2.5 lg:py-2 px-3 sm:px-4 lg:px-4"
            : layout === "horizontal"
              ? "w-full max-w-[220px] min-h-14 py-2.5 px-4"
              : "w-64 sm:w-70 min-h-16 sm:min-h-18 py-2 px-4 mb-2.5",

        // Pseudo-elemento before (barra decorativa derecha)
        "before:content-[''] before:absolute before:top-0 before:h-full before:transition-all before:duration-300 before:-z-10 before:skew-x-[-10deg] before:translate-x-0",
        layout === "responsive"
            ? "before:right-[-12px] before:w-[6px] sm:before:right-[-8px] sm:before:w-[5px] lg:before:right-[-15px] lg:before:w-[7px]"
            : layout === "horizontal"
              ? "before:right-[-8px] before:w-[5px]"
              : "before:right-[-15px] before:w-[7px]",

        // Pseudo-elemento after (cuerpo inclinado principal hacia la izquierda)
        "after:content-[''] after:absolute after:top-0 after:h-full after:transition-all after:duration-300 after:-z-10 after:right-0 after:skew-x-[-10deg] after:translate-x-0",
        layout === "responsive"
            ? "after:w-[calc(100%+45px)] sm:after:w-[calc(100%+12px)] lg:after:w-[calc(100%+70px)]"
            : layout === "horizontal"
              ? "after:w-[calc(100%+12px)]"
              : "after:w-[calc(100%+50px)] sm:after:w-[calc(100%+70px)]",

        // Configuración de Colores según Variant
        isPrimary
            ? "text-white hover:before:bg-primary-400 hover:after:bg-primary-400 [.is-active&]:before:bg-primary-400 [.is-active&]:after:bg-primary-400"
            : "text-secondary-50 hover:before:bg-black hover:after:bg-black [.is-active&]:before:bg-black [.is-active&]:after:bg-black",

        // Fondos por defecto (transparentes si no está activo/hover)
        "before:bg-transparent after:bg-transparent",
        { "is-active": isActive },
        className,
    ]}
>
    <!-- Línea 1: Nombre -->
    <span
        class:list={[
            "block text-base sm:text-lg lg:text-xl leading-none font-serif tracking-normal",
            "text-secondary-50/80",
            isPrimary
                ? "group-hover:text-black"
                : "group-hover:text-secondary-50",
        ]}
    >
        {text}
    </span>

    <!-- Línea 2: Precio -->
    {
        price && (
            <span
                class:list={[
                    "block text-sm font-sans tracking-normal mt-1 leading-none font-black",
                    "text-secondary-50/80 group-hover:text-black",
                ]}
            >
                {price}
            </span>
        )
    }
</button>
