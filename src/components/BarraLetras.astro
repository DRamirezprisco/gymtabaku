---
const { text1, text2, notdark } = Astro.props;
const palabras = [text1, text2, text1, text2, text1, text2, text1, text2];

const bg = notdark ? "bg-gym-bg" : "bg-gym-dark-bg";
---

<div class=`${bg} overflow-hidden w-full relative`>
  <div
    class="banderole whitespace-nowrap relative h-16 sm:h-34 px-8"
    style="width: max-content; min-width: 200%;"
  >
    <div
      class="uppercase tracking-wider italic h-full flex items-center gap-2 md:gap-4 whitespace-nowrap text-[clamp(3rem,8vw,6rem)] leading-none min-w-max"
      style=""
    >
      {
        palabras.map((palabra, index) => {
          if (index % 2 == 0) {
            return (
              <span class="font-poppins font-extrabold text-transparent bg-clip-text bg-linear-30 from-primary-400 via-primary-500 via-40% to-orange-500 to-80% pr-2 md:pr-3.75 ">
                {palabra}
              </span>
            );
          } else {
            return (
              <span class="font-poppins text-gym-text-secondary [-webkit-text-stroke:4px_#ffcc00] text-center relative pr-2 md:pr-3.75">
                {palabra}
              </span>
            );
          }
        })
      }
    </div>
  </div>
</div>
