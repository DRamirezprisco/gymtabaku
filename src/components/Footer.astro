---
import Icon from "@/components/Icon.astro";
---

<footer
  class="relative bg-[url('/img/bg/footer.webp')] bg-cover bg-no-repeat bg-top z-10 overflow-x-hidden"
>
  <div
    class="max-w-md sm:max-w-lg md:max-w-4xl lg:max-w-6xl xl:max-w-7xl mx-auto w-full"
  >
    <div class="w-full text-center py-2 sm:pt-20">
      <img
        class="animate-swing-drop-in h-28 sm:h-36 t-12 object-contain w-full"
        src="/img/logo.webp"
        alt="logo gym"
      />
      <h2
        class="my-5 text-4xl sm:text-3xl md:text-2xl xl:text-3xl 2xl:text-5xl font-bold uppercase font-serif text-primary-500"
      >
        GYM TABAKU
      </h2>
      <p
        class="text-center font-extralight text-secondary-300 text-lg md:text-md lg:text-lg w-full my-2"
      >
        ¡Juntos somos más fuertes!
      </p>
      <div class="flex justify-center gap-3 items-center pt-3">
        <a
          target="_blank"
          href="/"
          class="rounded-full border-4 bg-white/10 border-black hover:border-primary-500 p-4 hover:bg-primary-500 group"
          ><svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="stroke-white group-hover:stroke-black size-8"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path
              d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"
            ></path>
            <path d="M3 7l9 6l9 -6"></path>
          </svg>
        </a>
        <a
          target="_blank"
          href="/"
          class="rounded-full border-4 bg-white/10 border-black hover:border-primary-500 p-4 hover:bg-primary-500 group"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="stroke-white group-hover:stroke-black size-8"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"></path>
            <path
              d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"
            ></path>
          </svg>
        </a>
      </div>
    </div>

    <div
      class="flex flex-col md:flex-row lg:gap-10 justify-center items-center mb-20"
    >
      <div
        class="bg-white/10 animate-fade-in-up w-auto md:w-1/2 lg:py-8 px-12 2xl:px-14 rounded-2xl mt-6 lg:mt-12"
      >
        <h2
          class="text-xl lg:text-2xl xl:text-3xl text-gym-yellow-hover mx-auto font-rakkas"
        >
          Contactanos
        </h2>

        <div class="bg-gym-yellow h-0.5 w-full my-4 mb-10"></div>

        <div class="flex items-center gap-5 mb-5">
          <Icon>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="stroke-black size-9"
            >
              <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
              <path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"></path>
              <path
                d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0"
              ></path>
            </svg>
          </Icon>
          <div class="flex flex-col">
            <h3 class="text-secondary-50 text-lg lg:text-2xl font-bold">
              Dirección
            </h3>
            <p class="text-secondary-300 text-md xl:text-xl w-full">
              Dg. 3 #83-02, Kennedy
            </p>
          </div>
        </div>

        <div class="flex items-center gap-5 mb-5">
          <Icon
            ><svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="stroke-black size-9"
            >
              <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
              <path
                d="M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2"
              ></path>
            </svg></Icon
          >
          <div class="flex flex-col">
            <h3 class="text-secondary-50 text-lg lg:text-2xl font-bold">
              Telefono
            </h3>
            <p class="text-secondary-300 text-md xl:text-xl w-full">
              3158361031
            </p>
          </div>
        </div>

        <div class="flex items-center gap-5 mb-5">
          <Icon>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="stroke-black size-9"
            >
              <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
              <path
                d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"
              ></path>
              <path d="M3 7l9 6l9 -6"></path>
            </svg>
          </Icon>
          <div class="flex flex-col">
            <h3 class="text-secondary-50 text-lg lg:text-2xl font-bold">
              Email
            </h3>
            <p class="text-secondary-300 text-md xl:text-xl w-full">
              Gymtabaku@gmail.com
            </p>
          </div>
        </div>
      </div>

      <div
        class="animate-fade-in-up w-1/2 pt-12 xl:pb-8 px-4 2xl:px-14 hidden lg:block"
      >
        <a target="_blank" href="/"
          ><img
            class="h-72 w-full rounded-3xl object-cover"
            src="/img/map.webp"
            alt="mapa"
          /></a
        >
      </div>
    </div>
  </div>

  <div class="bg-gym-yellow flex text-white justify-center items-center">
    <p class="text-secondary-950 font-medium pr-4 py-2">
      Diseñado por Daniela Ramirez. Contactame
    </p>
    <a target="_blank" href="https://wa.me/573223139467">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="stroke-black size-8"
      >
        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
        <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"></path>
        <path
          d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"
        ></path>
      </svg>
    </a>
  </div>
</footer>

<style>
  .animateShakekettlebell {
    animation: shakeCirculos 3s ease-in-out infinite;
  }

  @keyframes shakeCirculos {
    0% {
      transform: translateX(0) translateY(0);
    }
    25% {
      transform: translateX(15px) translateY(0px);
    }
    50% {
      transform: translateX(15px) translateY(15px);
    }
    75% {
      transform: translateX(0px) translateY(15px);
    }
    100% {
      transform: translateX(0) translateY(0px);
    }
  }
</style>
