---
import Icon from "@/components/global/Icon.astro";
import { SITE_CONFIG } from "@/components/constants/site";
---

<footer
  class="relative bg-[url('/img/bg/footer.webp')] bg-cover bg-no-repeat bg-top z-10 overflow-x-hidden pt-12 sm:pt-16 md:pt-20"
>
  <div class="max-w-6xl 2xl:max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8">
    {/* Cabecera del Footer: Logo, Título y Redes */}
    <div class="w-full text-center" data-reveal="fade-up">
      <img
        class="h-20 sm:h-24 md:h-28 object-contain mx-auto"
        src="/img/logo.webp"
        alt="logo gym tabaku"
      />
      <h2
        class="my-3 sm:my-4 text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black uppercase font-serif text-primary-500 tracking-wider"
      >
        {SITE_CONFIG.name}
      </h2>
      <p
        class="text-center text-secondary-300 text-sm sm:text-base lg:text-lg font-medium tracking-wide max-w-md mx-auto"
      >
        {SITE_CONFIG.sloganSecondary}
      </p>

      {/* Botones Sociales Redondos */}
      <div class="flex justify-center gap-3 sm:gap-4 items-center pt-4 sm:pt-5">
        <a
          target="_blank"
          href={SITE_CONFIG.contact.emailMailto}
          aria-label="Enviar correo a Gym Tabaku"
          class="rounded-full bg-gym-dark-bg-card-hover p-3 sm:p-3.5 hover:bg-primary-500 group transition-all duration-200 hover:scale-105"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="stroke-white group-hover:stroke-black size-6 sm:size-7 transition-colors"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path
              d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"
            ></path>
            <path d="M3 7l9 6l9 -6"></path>
          </svg>
        </a>

        <a
          target="_blank"
          href={SITE_CONFIG.contact.whatsappUrl}
          aria-label="Contactar por WhatsApp a Gym Tabaku"
          class="rounded-full bg-gym-dark-bg-card-hover p-3 sm:p-3.5 hover:bg-primary-500 group transition-all duration-200 hover:scale-105"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="stroke-white group-hover:stroke-black size-6 sm:size-7 transition-colors"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"></path>
            <path
              d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"
            ></path>
          </svg>
        </a>
      </div>
    </div>

    {/* Sección de Contenido: Tarjeta de Contacto + Mapa Interactivo */}
    <div
      class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 lg:gap-12 items-stretch mt-10 sm:mt-14 mb-16 sm:mb-20 max-w-5xl mx-auto"
    >
      {/* Tarjeta de Contacto */}
      <div
        class="bg-secondary-50/10 backdrop-blur-md border border-white/10 p-6 sm:p-8 lg:p-10 rounded-2xl shadow-2xl flex flex-col justify-between"
        data-reveal="fade-right"
        data-reveal-delay="100"
      >
        <div>
          <h2
            class="text-2xl sm:text-3xl text-gym-yellow font-black tracking-wide uppercase"
          >
            Contáctanos
          </h2>

          <div class="bg-gym-yellow h-0.5 w-full my-4 mb-6 sm:mb-8"></div>

          <div class="space-y-4 sm:space-y-6">
            {/* Dirección */}
            <div class="flex items-center gap-4 sm:gap-5">
              <Icon>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="stroke-black size-6"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"></path>
                  <path
                    d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0"
                  ></path>
                </svg>
              </Icon>
              <div class="flex flex-col min-w-0">
                <h3
                  class="text-secondary-50 text-base sm:text-lg lg:text-xl font-bold"
                >
                  Dirección
                </h3>
                <p class="text-secondary-300 text-sm sm:text-base truncate">
                  {SITE_CONFIG.contact.address}
                </p>
              </div>
            </div>

            {/* Teléfono */}
            <div class="flex items-center gap-4 sm:gap-5">
              <Icon>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="stroke-black size-6"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path
                    d="M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2"
                  ></path>
                </svg>
              </Icon>
              <div class="flex flex-col min-w-0">
                <h3
                  class="text-secondary-50 text-base sm:text-lg lg:text-xl font-bold"
                >
                  Teléfono
                </h3>
                <a
                  href={SITE_CONFIG.contact.phoneTel}
                  class="text-secondary-300 hover:text-primary-400 text-sm sm:text-base transition-colors"
                >
                  {SITE_CONFIG.contact.phone}
                </a>
              </div>
            </div>

            {/* Email */}
            <div class="flex items-center gap-4 sm:gap-5">
              <Icon>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="stroke-black size-6"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path
                    d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"
                  ></path>
                  <path d="M3 7l9 6l9 -6"></path>
                </svg>
              </Icon>
              <div class="flex flex-col min-w-0">
                <h3
                  class="text-secondary-50 text-base sm:text-lg lg:text-xl font-bold"
                >
                  Email
                </h3>
                <a
                  href={SITE_CONFIG.contact.emailMailto}
                  class="text-secondary-300 hover:text-primary-400 text-sm sm:text-base truncate transition-colors"
                >
                  {SITE_CONFIG.contact.email}
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Columna Mapa */}
      <div
        class="hidden md:flex rounded-2xl overflow-hidden shadow-2xl border border-white/10 items-center justify-center min-h-[260px] sm:min-h-[300px] h-full"
        data-reveal="fade-left"
        data-reveal-delay="100"
      >
        <a
          target="_blank"
          href={SITE_CONFIG.contact.googleMapsUrl}
          aria-label="Ver ubicación en Google Maps"
          class="block w-full h-full relative group overflow-hidden"
        >
          <img
            class="h-full w-full object-cover min-h-[260px] sm:min-h-[300px] transition-transform duration-500 group-hover:scale-105"
            src="/img/map.webp"
            alt="Ubicación Gym Tabaku en el mapa"
          />
          <div
            class="absolute inset-0 bg-black/20 group-hover:bg-transparent transition-colors duration-300"
          >
          </div>
        </a>
      </div>
    </div>
  </div>

  {/* Barra Inferior de Créditos */}
  <div
    class="bg-gym-yellow py-2.5 px-4 flex items-center justify-center gap-2 text-center select-none"
  >
    <p class="text-secondary-950 font-bold text-xs sm:text-sm">
      Diseñado por {SITE_CONFIG.developer.name}. Contáctame
    </p>
    <a
      target="_blank"
      href={SITE_CONFIG.developer.whatsappUrl}
      aria-label={`Contactar a ${SITE_CONFIG.developer.name} por WhatsApp`}
      class="inline-flex items-center text-secondary-950 hover:scale-110 transition-transform duration-200"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-5 stroke-current"
      >
        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
        <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"></path>
        <path
          d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"
        ></path>
      </svg>
    </a>
  </div>
</footer>
