---
import type { ServiceItem } from "@/components/constants/services";

export interface Props {
    items: ServiceItem[];
}

const { items = [] } = Astro.props;

// Serializar los datos relevantes para el reproductor en el cliente
const clientVideoData = items.map((item, index) => ({
    index,
    title: item.title,
    subtitle: item.subtitle,
    videoUrl: item.videoUrl,
    posterUrl: item.posterUrl,
    serviceItemId: item.serviceItemId,
}));
---

<!-- Modal de Video Pantalla Completa con Audio -->
<div
    id="serviceVideoModal"
    class="fixed inset-0 z-50 hidden opacity-0 transition-opacity duration-300 bg-black/95 backdrop-blur-md items-center justify-center p-3 sm:p-6 lg:p-8"
    role="dialog"
    aria-modal="true"
    aria-label="Reproductor de video de servicio"
    data-videos={JSON.stringify(clientVideoData)}
>
    <!-- Capa de fondo para cerrar al hacer clic fuera -->
    <div id="svmBackdrop" class="absolute inset-0 z-0"></div>

    <!-- Contenedor Principal del Modal -->
    <div
        class="relative z-10 w-full max-w-5xl flex flex-col items-center justify-center my-auto"
    >
        <!-- Barra Superior: Info del Servicio y Botón de Cierre -->
        <div class="w-full flex items-center justify-between mb-3 sm:mb-4 px-1">
            <div class="flex flex-col text-left">
                <div class="flex items-center gap-2 sm:gap-3">
                    <span
                        id="svmCategory"
                        class="text-[11px] sm:text-xs font-bold uppercase tracking-widest text-primary-400 bg-primary-950/80 border border-primary-500/40 px-3 py-1 rounded-full shadow"
                    >
                        {items[0]?.title || "Servicio"}
                    </span>
                </div>
                <h3
                    id="svmTitle"
                    class="text-white font-bold font-serif text-sm sm:text-xl lg:text-2xl mt-1.5 drop-shadow-md line-clamp-1"
                >
                    {items[0]?.subtitle || ""}
                </h3>
            </div>

            <!-- Botón Cerrar (X) -->
            <button
                id="svmCloseBtn"
                type="button"
                aria-label="Cerrar video"
                class="size-10 sm:size-12 rounded-full bg-neutral-900/90 hover:bg-primary-500 text-white hover:text-black border border-white/20 flex items-center justify-center transition-all duration-200 cursor-pointer shadow-2xl active:scale-95 shrink-0 ml-3"
            >
                <svg
                    class="size-5 sm:size-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2.5"
                        d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <!-- Área Central del Video y Flechas de Navegación -->
        <div class="relative w-full flex items-center justify-center">
            <!-- Botón Navegación Anterior (Izquierda) -->
            <button
                id="svmPrevBtn"
                type="button"
                aria-label="Video anterior"
                class="absolute -left-2 sm:-left-6 md:-left-8 lg:-left-12 top-1/2 -translate-y-1/2 z-20 size-11 sm:size-13 md:size-14 rounded-full bg-black/80 hover:bg-primary-500 text-white hover:text-black border border-white/20 flex items-center justify-center transition-all duration-200 cursor-pointer shadow-2xl active:scale-90 group"
            >
                <svg
                    class="size-6 sm:size-7 transform group-hover:-translate-x-0.5 transition-transform"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2.5"
                        d="M15 19l-7-7 7-7"></path>
                </svg>
            </button>

            <!-- Video Player HTML5 con controles completos -->
            <div
                class="relative w-full aspect-video max-h-[70vh] sm:max-h-[76vh] lg:max-h-[78vh] rounded-xl sm:rounded-2xl overflow-hidden bg-black shadow-2xl border border-white/10 flex items-center justify-center"
            >
                <!-- Indicador de buffer mientras inicia -->
                <div
                    id="svmLoader"
                    class="absolute inset-0 z-10 flex items-center justify-center bg-black/40 pointer-events-none transition-opacity duration-300 opacity-0"
                >
                    <div
                        class="size-12 rounded-full border-3 border-white/20 border-t-primary-500 animate-spin"
                    >
                    </div>
                </div>

                <video
                    id="svmVideo"
                    class="w-full h-full object-contain bg-black"
                    controls
                    playsinline
                    preload="auto"
                >
                    Tu navegador no soporta la reproducción de video.
                </video>
            </div>

            <!-- Botón Navegación Siguiente (Derecha) -->
            <button
                id="svmNextBtn"
                type="button"
                aria-label="Siguiente video"
                class="absolute -right-2 sm:-right-6 md:-right-8 lg:-right-12 top-1/2 -translate-y-1/2 z-20 size-11 sm:size-13 md:size-14 rounded-full bg-black/80 hover:bg-primary-500 text-white hover:text-black border border-white/20 flex items-center justify-center transition-all duration-200 cursor-pointer shadow-2xl active:scale-90 group"
            >
                <svg
                    class="size-6 sm:size-7 transform group-hover:translate-x-0.5 transition-transform"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2.5"
                        d="M9 5l7 7-7 7"></path>
                </svg>
            </button>
        </div>

        <!-- Barra Inferior en Móvil: Botones Anterior/Siguiente Adicionales para Mejor Ergonomía -->
        <div
            class="flex sm:hidden items-center justify-between w-full mt-3 px-2"
        >
            <button
                id="svmPrevBtnMobile"
                type="button"
                class="flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-neutral-900 border border-white/15 text-white font-medium text-xs active:bg-primary-500 active:text-black cursor-pointer"
            >
                <svg
                    class="size-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2.5"
                        d="M15 19l-7-7 7-7"></path>
                </svg>
                <span>Anterior</span>
            </button>

            <span
                class="text-xs text-secondary-400 font-mono"
                id="svmCounterMobile"
            >
                1 / {items.length}
            </span>

            <button
                id="svmNextBtnMobile"
                type="button"
                class="flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-neutral-900 border border-white/15 text-white font-medium text-xs active:bg-primary-500 active:text-black cursor-pointer"
            >
                <span>Siguiente</span>
                <svg
                    class="size-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2.5"
                        d="M9 5l7 7-7 7"></path>
                </svg>
            </button>
        </div>

        <!-- Atajos de teclado informativos (Desktop) -->
        <div
            class="hidden md:flex items-center justify-center gap-6 mt-3 text-xs text-secondary-400"
        >
            <span
                ><kbd
                    class="px-1.5 py-0.5 rounded bg-white/10 text-white font-mono text-[10px]"
                    >Esc</kbd
                > Cerrar</span
            >
            <span
                ><kbd
                    class="px-1.5 py-0.5 rounded bg-white/10 text-white font-mono text-[10px]"
                    >←</kbd
                > Video anterior</span
            >
            <span
                ><kbd
                    class="px-1.5 py-0.5 rounded bg-white/10 text-white font-mono text-[10px]"
                    >→</kbd
                > Siguiente video</span
            >
            <span
                ><kbd
                    class="px-1.5 py-0.5 rounded bg-white/10 text-white font-mono text-[10px]"
                    >Espacio</kbd
                > Pausar / Reproducir</span
            >
        </div>
    </div>
</div>

<script>
    interface VideoItem {
        index: number;
        title: string;
        subtitle: string;
        videoUrl: string;
        posterUrl: string;
        serviceItemId: string;
    }

    function initServiceVideoModal() {
        const modal = document.getElementById(
            "serviceVideoModal",
        ) as HTMLElement;
        if (!modal) return;

        const video = document.getElementById("svmVideo") as HTMLVideoElement;
        const closeBtn = document.getElementById(
            "svmCloseBtn",
        ) as HTMLButtonElement;
        const prevBtn = document.getElementById(
            "svmPrevBtn",
        ) as HTMLButtonElement;
        const nextBtn = document.getElementById(
            "svmNextBtn",
        ) as HTMLButtonElement;
        const prevBtnMobile = document.getElementById(
            "svmPrevBtnMobile",
        ) as HTMLButtonElement;
        const nextBtnMobile = document.getElementById(
            "svmNextBtnMobile",
        ) as HTMLButtonElement;
        const backdrop = document.getElementById("svmBackdrop") as HTMLElement;
        const categoryEl = document.getElementById(
            "svmCategory",
        ) as HTMLElement;
        const titleEl = document.getElementById("svmTitle") as HTMLElement;
        const counterEl = document.getElementById("svmCounter") as HTMLElement;
        const counterMobileEl = document.getElementById(
            "svmCounterMobile",
        ) as HTMLElement;
        const loaderEl = document.getElementById("svmLoader") as HTMLElement;

        let videos: VideoItem[] = [];
        try {
            videos = JSON.parse(modal.dataset.videos || "[]");
        } catch {
            videos = [];
        }

        if (videos.length === 0 || !video) return;

        let currentIndex = 0;
        let isOpen = false;

        const syncTabs = (index: number) => {
            const menu = document.getElementById("service-menu");
            const buttons = menu?.querySelectorAll("button");
            buttons?.[index]?.click();
        };

        const updateModalContent = () => {
            const item = videos[currentIndex];
            if (!item) return;

            if (categoryEl) categoryEl.textContent = item.title;
            if (titleEl) titleEl.textContent = item.subtitle;
            const counterText = `${currentIndex + 1} / ${videos.length}`;
            if (counterEl) counterEl.textContent = counterText;
            if (counterMobileEl) counterMobileEl.textContent = counterText;
        };

        const loadAndPlayCurrentVideo = () => {
            const item = videos[currentIndex];
            if (!item) return;

            updateModalContent();

            if (loaderEl) loaderEl.classList.remove("opacity-0");

            // Pausar cualquier reproducción previa
            video.pause();

            // Configurar video con audio y arrancando desde el inicio (segundo 0)
            video.src = item.videoUrl;
            video.currentTime = 0;
            video.muted = false;
            video.volume = 1.0;

            const playPromise = video.play();
            if (playPromise !== undefined) {
                playPromise
                    .then(() => {
                        if (loaderEl) loaderEl.classList.add("opacity-0");
                    })
                    .catch(() => {
                        // En caso de que el navegador restrinja autoplay con audio sin interacción previa
                        if (loaderEl) loaderEl.classList.add("opacity-0");
                    });
            }
        };

        const openModal = (index: number) => {
            currentIndex = index >= 0 && index < videos.length ? index : 0;
            isOpen = true;

            // Pausar todos los videos de fondo de las tarjetas
            document
                .querySelectorAll<HTMLVideoElement>(".video-player")
                .forEach((v) => {
                    v.pause();
                });

            // Mostrar modal
            modal.classList.remove("hidden");
            modal.classList.add("flex");
            // Forzar reflow para animación fluida
            void modal.offsetWidth;
            modal.classList.remove("opacity-0");
            modal.classList.add("opacity-100");
            document.body.style.overflow = "hidden";

            // Reproducir con sonido desde 0
            loadAndPlayCurrentVideo();

            // Sincronizar pestaña de servicio correspondiente
            syncTabs(currentIndex);
        };

        const closeModal = () => {
            if (!isOpen) return;
            isOpen = false;

            // Pausar y cortar audio inmediatamente
            video.pause();
            video.removeAttribute("src");
            video.load();

            modal.classList.remove("opacity-100");
            modal.classList.add("opacity-0");

            setTimeout(() => {
                if (!isOpen) {
                    modal.classList.remove("flex");
                    modal.classList.add("hidden");
                    document.body.style.overflow = "";
                }
            }, 300);

            // Reanudar el video de la tarjeta activa de fondo
            const activeArticle = document.querySelector("article.is-active");
            const activeVid = activeArticle?.querySelector(
                ".video-player",
            ) as HTMLVideoElement;
            if (activeVid) {
                activeVid.play().catch(() => {});
            }
        };

        const nextVideo = () => {
            currentIndex = (currentIndex + 1) % videos.length;
            loadAndPlayCurrentVideo();
            syncTabs(currentIndex);
        };

        const prevVideo = () => {
            currentIndex = (currentIndex - 1 + videos.length) % videos.length;
            loadAndPlayCurrentVideo();
            syncTabs(currentIndex);
        };

        // Eventos de botones
        closeBtn?.addEventListener("click", closeModal);
        backdrop?.addEventListener("click", closeModal);
        nextBtn?.addEventListener("click", nextVideo);
        prevBtn?.addEventListener("click", prevVideo);
        nextBtnMobile?.addEventListener("click", nextVideo);
        prevBtnMobile?.addEventListener("click", prevVideo);

        // Control de teclado
        const handleKeyDown = (e: KeyboardEvent) => {
            if (!isOpen) return;

            if (e.key === "Escape") {
                e.preventDefault();
                closeModal();
            } else if (e.key === "ArrowRight") {
                e.preventDefault();
                nextVideo();
            } else if (e.key === "ArrowLeft") {
                e.preventDefault();
                prevVideo();
            }
        };

        window.removeEventListener("keydown", handleKeyDown);
        window.addEventListener("keydown", handleKeyDown);

        // Ocultar loader cuando comience la reproducción
        video.addEventListener("playing", () => {
            if (loaderEl) loaderEl.classList.add("opacity-0");
        });

        // Registrar los triggers en las tarjetas de video
        const registerTriggers = () => {
            document
                .querySelectorAll<HTMLElement>("[data-open-service-video]")
                .forEach((trigger) => {
                    if (trigger.dataset.modalListenerAttached) return;
                    trigger.dataset.modalListenerAttached = "true";

                    trigger.addEventListener("click", (e) => {
                        e.preventDefault();
                        const idxStr = trigger.dataset.openServiceVideo;
                        const idx = idxStr ? parseInt(idxStr, 10) : 0;
                        openModal(isNaN(idx) ? 0 : idx);
                    });

                    // Accesibilidad con teclado (Enter o Espacio)
                    trigger.addEventListener("keydown", (e: KeyboardEvent) => {
                        if (e.key === "Enter" || e.key === " ") {
                            e.preventDefault();
                            const idxStr = trigger.dataset.openServiceVideo;
                            const idx = idxStr ? parseInt(idxStr, 10) : 0;
                            openModal(isNaN(idx) ? 0 : idx);
                        }
                    });
                });
        };

        registerTriggers();
    }

    document.addEventListener("astro:page-load", initServiceVideoModal);
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initServiceVideoModal);
    } else {
        initServiceVideoModal();
    }
</script>
