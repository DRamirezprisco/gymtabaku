---
import Titulo from "@/components/global/Titulo.astro";

const {
    title,
    icon,
    subtitle,
    videoUrl,
    posterUrl,
    description,
    serviceItemId,
    isActive = false,
    index = 0,
} = Astro.props;
---

<article
    id={serviceItemId}
    class:list={[
        "w-full hidden flex-col items-center lg:items-start text-center lg:text-left px-2 sm:px-4 lg:px-6 [.is-active&]:flex",
        { "is-active": isActive },
    ]}
>
    <Titulo title={title || ""} isdark={true} />

    <div
        class="flex items-center justify-center lg:justify-start gap-2.5 sm:gap-3 my-2"
    >
        {
            icon == "coach" && (
                <img
                    src="/img/services/svgCoach.webp"
                    alt="coach"
                    class="size-10"
                />
            )
        }
        {
            icon == "zonas" && (
                <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    class="size-8 fill-gym-dark-text-secondary"
