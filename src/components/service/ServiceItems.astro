<script>
    document.addEventListener("DOMContentLoaded", () => {
        // Obseravador para detectar cambios de clase (.is-active)
        const observer = new MutationObserver((mutations) => {
            mutations.forEach((mutation) => {
                if (
                    mutation.type === "attributes" &&
                    mutation.attributeName === "class"
                ) {
                    const article = mutation.target as HTMLElement;
                    const video = article.querySelector(
                        "video",
                    ) as HTMLVideoElement;

                    if (!video) return;

                    // Si la tarjeta obtiene la clase .is-active (al hacer clic en la opción)
                    if (article.classList.contains("is-active")) {
                        video.currentTime = 0; // Reinicia el video al segundo 0
                        video.play().catch(() => {});
                    } else {
                        // Si pierde la clase .is-active, se pausa
                        video.pause();
                    }
                }
            });
        });

        // Aplicar el observador a todos los artículos
        document.querySelectorAll("article").forEach((article) => {
            observer.observe(article, { attributes: true });

            // Verificar si alguno ya viene activo por defecto al cargar
            if (article.classList.contains("is-active")) {
                const video = article.querySelector(
                    "video",
                ) as HTMLVideoElement;
                if (video) {
                    video.currentTime = 0;
                    video.play().catch(() => {});
                }
            }
        });
    });
</script>
