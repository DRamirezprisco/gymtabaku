---
import Menu from "@/components/Menu.astro";
import ButtonSkew from "@/components/global/ButtonSkew.astro";
import ServiceItems from "@/components/service/ServiceItems.astro";
import ServiceVideoModal from "@/components/service/ServiceVideoModal.astro";
import type { ServiceItem } from "@/components/constants/services";

export type { ServiceItem };

export interface Props {
  items?: ServiceItem[];
}

const { items = [] } = Astro.props;
---

<section
  class="relative bg-black bg-cover w-full overflow-hidden min-h-screen pb-12 sm:pb-16"
>
  <div
    class="absolute inset-0 overflow-hidden pointer-events-none select-none"
    data-reveal="fade-in"
    data-reveal-delay="100"
  >
    <img
      src="/img/bg/intento4.jpg"
      alt=""
      class="absolute -left-20 sm:-left-35 rotate-180 top-0 w-auto object-cover opacity-60 sm:opacity-80 mix-blend-screen h-full pointer-events-none select-none"
    />
  </div>

  <div class="relative z-10">
    <Menu />

    <main
      class="max-w-6xl 2xl:max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 sm:py-12 md:py-16"
    >
      <header
        class="max-w-4xl mx-auto text-center mb-8 sm:mb-12 lg:mb-16"
        data-reveal="fade-up"
        data-reveal-delay="0"
      >
        <h2
          class="mb-4 text-xs sm:text-sm md:text-base lg:text-lg font-bold tracking-widest uppercase text-gym-yellow"
        >
          ¡Entrena · crece · pertenece!
        </h2>
        <h1
          class="font-serif text-lg sm:text-xl md:text-2xl lg:text-3xl xl:text-4xl text-gym-dark-text-secondary font-black uppercase tracking-tight leading-tight"
        >
          Un espacio para entrenar, <br />
          crecer y sentirte como en casa
        </h1>
      </header>

      <div
        class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 lg:gap-12 items-start"
      >
        <nav
          class="w-full max-w-80 sm:max-w-none lg:max-w-78 mx-auto lg:ml-6 p-4 sm:p-6 lg:p-6 lg:pt-12 rounded-2xl bg-gym-bg-card/30 backdrop-blur-md shadow-xl border border-white/5 lg:col-span-4"
          data-reveal="fade-right"
          data-reveal-delay="250"
        >
          <ul
            class="grid grid-cols-1 sm:grid-cols-3 lg:flex lg:flex-col gap-4 sm:gap-8 md:gap-10 lg:gap-5 justify-items-center"
            id="service-menu"
          >
            {
              items.map((item, index) => (
                <li class="w-full flex justify-center">
                  <ButtonSkew text={item.title} isActive={index === 0} />
                </li>
              ))
            }
          </ul>
        </nav>

        <div
          id="servicesItemContainer"
          class="w-full lg:col-span-8"
          data-reveal="fade-left"
          data-reveal-delay="500"
        >
          {
            items.map((item, index) => (
              <ServiceItems
                title={item.title}
                icon={item.icon}
                subtitle={item.subtitle}
                videoUrl={item.videoUrl}
                posterUrl={item.posterUrl}
                description={item.description}
                serviceItemId={item.serviceItemId}
                isActive={index === 0}
                index={index}
              />
            ))
          }
        </div>
      </div>
    </main>
  </div>

  <ServiceVideoModal items={items} />
</section>
