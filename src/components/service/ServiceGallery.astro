---
import Titulo from "@/components/global/Titulo.astro";
import {
    SERVICE_DEFAULT_IMAGES,
    type ServiceImage,
} from "@/components/constants/services";

// Props opcionales para pasar imágenes dinámicas desde Services.astro
export interface Props {
    images?: ServiceImage[];
    isActive?: boolean;
    title?: string;
}

const { images, isActive, title } = Astro.props;

const galleryImages = images || SERVICE_DEFAULT_IMAGES;


const columns = [
    galleryImages.slice(0, 3),
    galleryImages.slice(3, 6),
    galleryImages.slice(6, 9),
    galleryImages.slice(9, 12),
];
---

<div 
class:list={[
        "gallery-title hidden my-4 sm:my-6 lg:my-8 text-center uppercase [.is-active&]:block",
        { "is-active": isActive },
    ]}
    data-reveal="fade-up"
    data-reveal-delay="100"
>
    <Titulo title={title || ""}></Titulo>          
</div>

<div 
    class:list={[
        "gallery-wrapper hidden grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 [.is-active&]:grid",
        { "is-active": isActive },
    ]}
    data-reveal="fade-up"
    data-reveal-delay="200"
>
    {columns.map((col) => (
        <div class="grid gap-3 sm:gap-4">
            {col.map((img) => (
                <div class="gallery-item group relative overflow-hidden rounded-xl cursor-pointer shadow-md hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1">
                    <img 
                        class="gallery-img h-full w-full rounded-xl object-cover transition-transform duration-500 ease-out group-hover:scale-110" 
                        src={img.src} 
                        alt={img.alt} 
                        loading="lazy"
                    />

                    <!-- Capa superior (Overlay) -->
                    <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-3 sm:p-4 pointer-events-none">
                        <div class="flex items-center justify-between text-white">
                            <span class="font-bold text-xs sm:text-sm uppercase tracking-wider text-primary-400 drop-shadow">
                                {img.alt}
                            </span>
                            <svg class="size-5 sm:size-6 text-white transform group-hover:scale-125 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"></path>
                            </svg>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    ))}

    <!-- Modal Popup centrado y accesible -->
    <dialog class="gallery-modal fixed inset-0 m-auto bg-transparent backdrop:bg-black/85 backdrop:backdrop-blur-sm p-0 max-w-4xl w-auto h-auto outline-none overflow-hidden transition-all border-none z-50">
        <div class="relative flex items-center justify-center p-2 sm:p-4">
            <!-- Botón de Cierre -->
            <button
                type="button"
                aria-label="Cerrar modal"
                class="close-modal absolute top-2 right-2 sm:top-4 sm:right-4 z-30 size-10 sm:size-11 bg-secondary-950/80 hover:bg-primary-500 text-white hover:text-black rounded-full flex items-center justify-center transition-all duration-200 cursor-pointer shadow-xl border border-white/20 active:scale-95"
            >
                <svg class="size-5 sm:size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>

            <!-- Contenedor y Foto centrada -->
            <div class="relative flex items-center justify-center">
                <img class="modal-img max-h-[80vh] sm:max-h-[85vh] max-w-[92vw] sm:max-w-[88vw] object-contain rounded-xl shadow-2xl border border-white/10" src="" alt="" />
            </div>
        </div>
    </dialog>
</div>

<script>
    function initGalleryModals() {
        document.querySelectorAll(".gallery-wrapper").forEach((gallery) => {
            const modal = gallery.querySelector(".gallery-modal") as HTMLDialogElement;
            const modalImg = gallery.querySelector(".modal-img") as HTMLImageElement;
            const closeBtn = gallery.querySelector(".close-modal") as HTMLButtonElement;
            const galleryItems = gallery.querySelectorAll(".gallery-item");

            if (!modal || !modalImg || !closeBtn) return;

            galleryItems.forEach((item) => {
                item.addEventListener("click", () => {
                    const img = item.querySelector(".gallery-img") as HTMLImageElement;

                    if (!img) return;

                    modalImg.src = img.src;
                    modalImg.alt = img.alt;

                    modal.showModal();
                    document.body.style.overflow = "hidden";
                });
            });

            const closeModal = () => {
                modal.close();
                document.body.style.overflow = "";
            };

            closeBtn.addEventListener("click", closeModal);

            modal.addEventListener("click", (event) => {
                if (event.target === modal) {
                    closeModal();
                }
            });

            modal.addEventListener("cancel", () => {
                document.body.style.overflow = "";
            });
        });
    }

    document.addEventListener("astro:page-load", initGalleryModals);
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initGalleryModals);
    } else {
        initGalleryModals();
    }
</script>

<style>
    /* Estilos para centrado y animación de apertura */
    dialog.gallery-modal {
        display: none;
    }

    dialog.gallery-modal[open] {
        display: flex;
        align-items: center;
        justify-content: center;
        animation: zoomIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes zoomIn {
        from {
            opacity: 0;
            transform: scale(0.92);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }
</style>