---
const { title, isdark, large } = Astro.props;
const textColor = isdark ? "text-gym-yellow" : "text-gym-text-secondary";
const textLarge = large ? "w-30" : "w-40";
---

<div class="flex items-center justify-center gap-3">
  <div class={`bg-gym-yellow h-1 ${textLarge}`}></div>
  <h3
    class={`font-serif text-base sm:text-lg md:text-xl lg:text-3xl ${textColor}`}
  >
    {title}
  </h3>
  <div class={`bg-gym-yellow h-1 ${textLarge}`}></div>
</div>
