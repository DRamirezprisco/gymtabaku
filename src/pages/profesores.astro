---
import Layout from "@/layouts/Layout.astro";
import CoachHeader from "@/components/coach/CoachHeader.astro";
import CoachDescription from "@/components/coach/CoachDescription.astro";
import CoachGallery from "@/components/coach/CoachGallery.astro";
import Footer from "@/components/Footer.astro";
import { COACHES_DATA } from "@/components/constants/coaches";
---

<Layout>
  <CoachHeader Coaches={COACHES_DATA} activeIndex={0} />
  <CoachDescription Coaches={COACHES_DATA} activeIndex={0} />
  <CoachGallery Coaches={COACHES_DATA} activeIndex={0} />
  <Footer />

  <script>
    function initCoachSelection() {
      const coachCards =
        document.querySelectorAll<HTMLElement>("[data-coach-card]");
      const descriptions = document.querySelectorAll<HTMLElement>(
        "[data-coach-description]",
      );
      const galleries = document.querySelectorAll<HTMLElement>(
        "[data-coach-gallery]",
      );

      if (!coachCards.length) return;

      coachCards.forEach((card) => {
        card.addEventListener("click", () => {
          const index = card.getAttribute("data-coach-index");
          if (index === null) return;

          // 1. Marcar tarjeta activa en el carrusel de profesores
          coachCards.forEach((c) => {
            const isMatch = c.getAttribute("data-coach-index") === index;
            c.setAttribute("data-active", isMatch ? "true" : "false");
          });

          // 2. Alternar descripciones de los profesores
          descriptions.forEach((desc) => {
            const isMatch =
              desc.getAttribute("data-coach-description") === index;
            if (isMatch) {
              desc.classList.remove("hidden");
              desc.classList.add("block");

              const rect = desc.getBoundingClientRect();
              if (rect.top < window.innerHeight) {
                desc
                  .querySelectorAll<HTMLElement>("[data-reveal]")
                  .forEach((el) => el.classList.add("is-revealed"));
              }
            } else {
              desc.classList.add("hidden");
              desc.classList.remove("block");
            }
          });

          // 3. Alternar galerías de los profesores
          galleries.forEach((gal) => {
            const isMatch = gal.getAttribute("data-coach-gallery") === index;
            if (isMatch) {
              gal.classList.remove("hidden");
              gal.classList.add("block");

              const rect = gal.getBoundingClientRect();
              if (rect.top < window.innerHeight) {
                gal
                  .querySelectorAll<HTMLElement>("[data-reveal]")
                  .forEach((el) => el.classList.add("is-revealed"));
              }
            } else {
              gal.classList.add("hidden");
              gal.classList.remove("block");
            }
          });

          // 4. Refrescar Swiper en las galerías que acaban de pasar a visibles
          window.dispatchEvent(new Event("resize"));
        });
      });
    }

    document.addEventListener("astro:page-load", initCoachSelection);
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initCoachSelection);
    } else {
      initCoachSelection();
    }
  </script>
</Layout>
