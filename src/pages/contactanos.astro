---
import Layout from "@/layouts/Layout.astro";
import ContactanosHeader from "@/components/contactanos/ContactanosHeader.astro";
import Footer from "@/components/Footer.astro";
---

<Layout
    title="Contáctanos"
    description="Ponte en contacto con Gym Tabaku en Bogotá, Kennedy. Escríbenos por WhatsApp o visítanos para tu clase de cortesía."
>
    <ContactanosHeader />
    <div class="w-full bg-gym-dark-bg h-2 overflow-hidden">
        <div
            class="h-1 sm:h-2 bg-gym-yellow w-full"
            data-reveal="expand-line"
            data-reveal-delay="200"
        >
        </div>
    </div>
    <Footer />
</Layout>
