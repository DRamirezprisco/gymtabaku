---
import Layout from "@/layouts/Layout.astro";
import ServiceHeader from "@/components/service/ServiceHeader.astro";
import Services from "@/components/service/Services.astro";
import Footer from "@/components/Footer.astro";
import { SERVICES_DATA } from "@/components/constants/services";
---

<Layout>
    <ServiceHeader items={SERVICES_DATA} />
    <Services items={SERVICES_DATA} />
    <Footer />
</Layout>

<script>
    function initServiceTabs() {
        const menu = document.getElementById("service-menu");
        const buttons = menu?.querySelectorAll("button");
        const container = document.getElementById("servicesItemContainer");
        const serviceItems = container?.querySelectorAll("article");
        const galleryContainer = document.getElementById("galleryContainer");
        const galleriesTitles =
            galleryContainer?.querySelectorAll(".gallery-title");
        const galleries = galleryContainer?.querySelectorAll(".gallery-wrapper");

        function activateTab(index: number, shouldScroll = false) {
            if (index < 0 || !buttons || index >= buttons.length) return;

            // Quitar la clase a todos los botones
            buttons.forEach((btn) => btn.classList.remove("is-active"));

            // Quitar la clase a todos los serviceItems
            serviceItems?.forEach((item) => item.classList.remove("is-active"));

            galleriesTitles?.forEach((item) =>
                item.classList.remove("is-active"),
            );

            galleries?.forEach((item) => item.classList.remove("is-active"));

            // Agregar la clase al botón seleccionado
            buttons[index]?.classList.add("is-active");

            // Agregar la clase al serviceItems seleccionado
            serviceItems?.[index]?.classList.add("is-active");

            galleriesTitles?.[index]?.classList.add("is-active");

            galleries?.[index]?.classList.add("is-active");

            // Si ya estamos viendo la galería o cerca de ella, revelar los elementos inmediatamente
            const currentGallery = galleries?.[index];
            if (currentGallery) {
                const rect = currentGallery.getBoundingClientRect();
                if (rect.top < window.innerHeight) {
                    galleriesTitles?.[index]?.classList.add("is-revealed");
                    currentGallery
                        .querySelectorAll<HTMLElement>("[data-reveal]")
                        .forEach((el) => {
                            el.classList.add("is-revealed");
                        });
                }
            }

            // Si se solicita scroll (por ejemplo, al llegar desde un enlace externo con hash)
            if (shouldScroll) {
                setTimeout(() => {
                    const scrollTarget = window.innerWidth < 1024
                        ? (document.getElementById("service-menu") || container)
                        : container;
                    if (scrollTarget) {
                        scrollTarget.scrollIntoView({ behavior: "smooth", block: "start" });
                    }
                }, 150);
            }
        }

        buttons?.forEach((button, index) => {
            button.addEventListener("click", () => {
                activateTab(index, false);
                const targetId = serviceItems?.[index]?.id;
                if (targetId && history.replaceState) {
                    history.replaceState(null, "", `#${targetId}`);
                }
            });
        });

        function checkUrlHash(shouldScroll = false) {
            const hash = window.location.hash.replace("#", "").trim().toLowerCase();
            const query = new URLSearchParams(window.location.search).get("servicio")?.trim().toLowerCase();
            const target = hash || query;

            if (target && serviceItems) {
                let foundIndex = -1;
                serviceItems.forEach((item, idx) => {
                    if (item.id.toLowerCase() === target) {
                        foundIndex = idx;
                    }
                });

                if (foundIndex >= 0) {
                    activateTab(foundIndex, shouldScroll);
                }
            }
        }

        // Revisar hash al cargar la página
        checkUrlHash(true);

        // Escuchar cambios de hash en la misma página
        window.removeEventListener("hashchange", () => checkUrlHash(true));
        window.addEventListener("hashchange", () => checkUrlHash(true));
    }

    document.addEventListener("astro:page-load", initServiceTabs);
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initServiceTabs);
    } else {
        initServiceTabs();
    }
</script>
