---

<Layout>
    <ServiceHeader items={items} />
    <Services items={items} />
    <Footer />
</Layout>

<script>
    // Interacción en el cliente para alternar la clase 'is-active'
    const menu = document.getElementById("service-menu");
    const buttons = menu?.querySelectorAll("button");
    const container = document.getElementById("servicesItemContainer");
    const serviceItems = container?.querySelectorAll("article");
    const galleryContainer = document.getElementById("galleryContainer");
    const galleriesTitles =
        galleryContainer?.querySelectorAll(".gallery-title");
    const galleries = galleryContainer?.querySelectorAll(".gallery-wrapper");

    buttons?.forEach((button, index) => {
        button.addEventListener("click", () => {
            // Quitar la clase a todos los botones
            buttons.forEach((btn) => btn.classList.remove("is-active"));

            // Quitar la clase a todos los serviceItems
            serviceItems?.forEach((item) => item.classList.remove("is-active"));

            galleriesTitles?.forEach((item) =>
                item.classList.remove("is-active"),
            );

            galleries?.forEach((item) => item.classList.remove("is-active"));

            // Agregar la clase al botón seleccionado
            button.classList.add("is-active");

            // Agregar la clase al serviceItems seleccionado
            serviceItems?.[index].classList.add("is-active");

            galleriesTitles?.[index].classList.add("is-active");

            galleries?.[index].classList.add("is-active");
        });
    });
</script>
