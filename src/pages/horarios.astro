---
import Layout from "@/layouts/Layout.astro";
import HorariosHeader from "@/components/horarios/HorariosHeader.astro";
import HorariosPrecios from "@/components/horarios/HorariosPrecios.astro";
import Footer from "@/components/Footer.astro";
---

<Layout
  title="Horarios y Precios"
  description="Consulta los horarios y planes de Gym Tabaku en Bogotá. Abierto todos los días del año con la mayor flexibilidad para entrenar."
>
  <HorariosHeader />
  <main id="main-content">
    <HorariosPrecios />
    <div class="hidden lg:block w-full bg-gym-dark-bg h-2 overflow-hidden">
      <div
        class="h-1 sm:h-2 bg-gym-yellow w-full"
        data-reveal="expand-line"
        data-reveal-delay="200"
      >
      </div>
    </div>
  </main>
  <Footer />
</Layout>
